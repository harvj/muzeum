<section id="guide-assignment" tabindex="-1" aria-labelledby="guide-assignment-heading">
  <h3 id="guide-assignment-heading"><%= catalog_title(entry) %></h3>
  <% if flash[:alert].present? %><p role="alert"><%= flash[:alert] %></p><% end %>
  <% if flash[:notice].present? %><p role="status"><%= flash[:notice] %></p><% end %>
  <% colors = effective_musical_colors(entry) %>
  <div class="identity-assignment-summary">
    <% if colors.any? %>
      <% description = colors.map { |color| MusicalIdentity::Palette::COLORS.fetch(color) }.to_sentence %>
      <%= tag.span class: "identity-badge", data: musical_identity_attributes(entry), title: description do %>
        <span class="identity-swatch" role="img" aria-label="<%= description %>"></span>
      <% end %>
    <% end %>
    <% if (inherited = inherited_musical_identity(entry)) %>
      <p>Inherited from <%= inherited.fetch(:artists).map(&:name).to_sentence %></p>
    <% elsif decision&.colors.present? %>
      <p>Direct assignment</p>
    <% else %>
      <p>Neutral</p>
    <% end %>
  </div>
  <% if decision && !@public_profile %>
    <p>Manually revised <%= browser_time(decision.created_at, date_only: true) %>.</p>
    <% if decision.rationale.present? %><p><%= decision.rationale %></p><% end %>
  <% end %>
  <% if @may_edit_identity %>
    <%= form_with scope: :musical_identity, url: polymorphic_path([:musical_identity, entry]), method: :patch,
      data: { turbo: false, controller: "identity-palette", identity_palette_colors_value: colors.to_json,
        action: "reset->identity-palette#restore formdata->identity-palette#serialize" } do |form| %>
      <%= form.hidden_field :head, value: decision&.id %>
      <fieldset class="identity-color-picker">
        <legend>Musical colors</legend>
        <div class="identity-choices">
          <% MusicalIdentity::Palette::COLORS.each do |color, description| %>
            <label class="identity-choice" title="<%= description %>">
              <%= check_box_tag "musical_identity[colors][]", color, colors.include?(color), id: "identity-color-#{color}",
                class: "visually-hidden", aria: { label: description },
                data: { identity_palette_target: "color", action: "change->identity-palette#choose" } %>
              <span class="identity-swatch identity-<%= color %>" aria-hidden="true"></span>
              <span class="identity-choice-order" aria-hidden="true"><%= colors.index(color) + 1 if colors.include?(color) %></span>
            </label>
          <% end %>
        </div>
        <p role="status" class="muted" data-identity-palette-target="status"></p>
      </fieldset>
      <%= form.label :rationale, "Musical rationale (required for three colors)" %>
      <%= form.text_area :rationale, value: decision&.rationale, maxlength: 1000, data: { identity_palette_target: "rationale" } %>
      <div class="catalog-actions">
        <%= form.submit "Save colors" %>
        <% if decision&.colors.present? %>
          <%= form.button(entry.is_a?(Artist) ? "Clear direct colors" : "Use inherited colors",
            name: "musical_identity[inherit]", value: "1", formnovalidate: true) %>
        <% end %>
      </div>
    <% end %>
  <% end %>
  <% evidence = @revision&.evidence&.fetch("musicbrainz", {}) || {} %>
  <% terms = (Array(evidence["genres"]) + Array(evidence["tags"])).pluck("name").compact.uniq %>
  <% if terms.any? %>
    <p>MusicBrainz evidence for this <%= entry.model_name.human.downcase %></p>
    <ul><% terms.each do |term| %><li><%= term %></li><% end %></ul>
  <% end %>
</section>
