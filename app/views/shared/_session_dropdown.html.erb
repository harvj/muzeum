<details class="harvj-session" data-controller="application-shell" data-application-shell-url-value="<%= application_shell_path(format: :json) %>"
         data-application-shell-binding-value="<%= ApplicationShellEvidence.session_binding(Current.session) %>"
         data-action="toggle->application-shell#toggle keydown.esc->application-shell#escape click@document->application-shell#outside pageshow@window->application-shell#restore pagehide@window->application-shell#clear visibilitychange@document->application-shell#refresh turbo:before-cache@document->application-shell#clear">
  <summary data-application-shell-target="trigger"><span class="shell-authenticated-dot" aria-hidden="true"></span><span data-application-shell-target="username"<%= " data-identity-pending" unless session_username %>><%= session_username || "Signed in" %></span><span aria-hidden="true">⌄</span></summary>
  <div class="harvj-session-panel">
    <div data-application-shell-target="applications" hidden>
      <p class="profile-label">Applications</p>
      <div data-application-shell-target="links"></div>
    </div>
    <% if OidcClient.configured? %>
      <%= link_to "Account Settings", "#{OidcClient::ISSUER}/account?#{URI.encode_www_form(client_id: ENV.fetch('OIDC_CLIENT_ID'))}" %>
    <% end %>
    <%= button_to "Log Out", session_path, method: :delete %>
  </div>
</details>
