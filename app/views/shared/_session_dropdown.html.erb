<details class="harvj-session" data-controller="application-shell"
         data-application-shell-url-value="<%= application_shell_path %>"
         data-action="toggle->application-shell#toggle keydown.esc->application-shell#escape pointerdown@document->application-shell#dismiss pageshow@window->application-shell#restore pagehide@window->application-shell#clear">
  <summary data-application-shell-target="trigger" aria-label="Signed in">
    <span class="session-dot" aria-hidden="true"></span>
    <span class="session-username" data-application-shell-target="username">Signed in</span>
    <span aria-hidden="true">⌄</span>
  </summary>
  <div class="harvj-session-panel">
    <section aria-labelledby="application-shell-applications" data-application-shell-target="applications" hidden>
      <h2 class="profile-label" id="application-shell-applications">Applications</h2>
      <div data-application-shell-target="destinations"></div>
    </section>
    <section class="profile-settings" aria-labelledby="application-shell-settings">
      <h2 class="profile-label" id="application-shell-settings">Muzeum settings</h2>
      <%= render "shared/appearance" %>
    </section>
    <% if (client_id = ENV["OIDC_CLIENT_ID"].presence) %>
      <%= link_to "Account Settings", "#{OidcClient::ISSUER}/account?#{URI.encode_www_form(client_id: client_id)}" %>
    <% end %>
    <%= button_to "Log Out", session_path, method: :delete %>
  </div>
</details>
