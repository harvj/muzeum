<details class="harvj-session">
  <summary aria-label="Session menu"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="9" r="3"/><path d="M5 19c1-6 13-6 14 0"/></svg><span>Profile</span><span aria-hidden="true">⌄</span></summary>
  <div class="harvj-session-panel">
    <p class="profile-label">Applications</p>
    <%= link_to "Auth", "https://auth.harvj.com/" %>
    <%= link_to "Continuum Engine", "https://funding.harvj.com/" %>
    <% if auth_administration_available? %>
      <%= link_to "User management", "https://auth.harvj.com/admin" %>
    <% end %>
    <div class="profile-settings">
      <p class="profile-label">Muzeum settings</p>
      <details class="appearance-submenu" data-controller="hover-disclosure" data-action="pointerenter->hover-disclosure#enter pointerleave->hover-disclosure#leave">
        <summary data-action="click->hover-disclosure#pin">Appearance <span aria-hidden="true">‹</span></summary>
        <%= render "shared/appearance" %>
      </details>
    </div>
    <%= button_to "Log out", session_path, method: :delete %>
  </div>
</details>
