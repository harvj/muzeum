<details class="harvj-session">
  <summary aria-label="Session menu"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="9" r="3"/><path d="M5 19c1-6 13-6 14 0"/></svg><span aria-hidden="true">⌄</span></summary>
  <div class="harvj-session-panel">
    <a href="https://funding.harvj.com/"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 20V4m0 16h18M6 15l4-5 4 3 6-9"/></svg>Continuum Engine</a>
    <a href="https://muzeum.fm/" aria-current="page"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M9 18V5l12-2v13M9 8l12-2"/><ellipse cx="6" cy="18" rx="3" ry="2"/><ellipse cx="18" cy="16" rx="3" ry="2"/></svg>Muzeum</a>
    <%# Auth has no administrator claim in its verified consumer contract. Fail closed:
        the protected /admin link is withheld until provider role evidence is available.
        See docs/p1.1d/shared-session-dropdown.md for the compatible adoption contract. %>
    <% if auth_administration_available? %>
      <a href="https://auth.harvj.com/admin"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 20v-2a6 6 0 0 1 12 0v2M17 5a3 3 0 0 1 0 6m1 3a5 5 0 0 1 3 5"/></svg>User management</a>
    <% end %>
    <%= button_to session_path, method: :delete do %><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M10 4H4v16h6m5-13 5 5-5 5M8 12h12"/></svg>Log out<% end %>
  </div>
</details>
