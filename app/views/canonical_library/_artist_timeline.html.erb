<% metric = local_assigns.fetch(:metric, :milliseconds) %>
<% counts = metric == :plays %>
<% maximum = [ @timeline.map { |_, totals| totals.public_send(metric) }.max, 1 ].max %>
<% colors = @activity_releases&.many? ? {} : musical_identity_attributes(@entry) %>
<% spacing = @timeline.size > 1 ? (@timeline[1][0] - @timeline[0][0]).to_i : 0 %>
<% date_format = spacing >= 365 ? "%Y" : (spacing >= 28 ? "%b %y" : "%b %-d") %>
<% step = [ (@timeline.size / 7.0).ceil, 1 ].max %>
<%= tag.figure class: "artist-timeline identity-chart", data: colors,
  aria: { label: counts ? "Plays by date" : "Estimated listening time by date" } do %>
  <div class="artist-timeline-axis" aria-hidden="true">
    <% [ maximum, maximum / 2, 0 ].each do |value| %><span><%= counts ? value : compact_listening_time(value) %></span><% end %>
  </div>
  <div class="artist-timeline-bars" aria-hidden="true">
    <% @timeline.each_with_index do |(date, totals), index| %>
      <div class="artist-timeline-column">
        <div class="artist-timeline-fill" data-controller="listening-scale" data-listening-scale-percent-value="<%= 100.0 * totals.public_send(metric) / maximum %>" title="<%= date.iso8601 %> · <%= counts ? pluralize(totals.plays, "play") : estimated_listening_time(totals) %>"></div>
        <% if (index % step).zero? %><span><%= date.strftime(date_format) %></span><% end %>
      </div>
    <% end %>
  </div>
<% end %>
<details class="artist-timeline-data">
  <summary>Listening history data</summary>
  <ul class="listening-periods">
    <% @timeline.each do |date, totals| %>
      <% duration = estimated_listening_time(totals) %>
      <li data-duration-ms="<%= totals.milliseconds %>">
        <time datetime="<%= date.iso8601 %>"><%= date.iso8601 %></time>
        <%= render "listening_bar", value: counts ? totals.plays : totals.milliseconds, maximum:,
          label: counts ? pluralize(totals.plays, "play") : duration, accessible_label: counts ? pluralize(totals.plays, "play") : duration, colors: %>
        <small><%= counts ? duration : pluralize(totals.plays, "play") %><% if totals.known_durations < totals.plays %> · <%= duration_coverage(totals) %><% end %></small>
      </li>
    <% end %>
  </ul>
</details>
