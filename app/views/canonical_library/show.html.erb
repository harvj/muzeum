<section class="intro">
  <p><%= link_to @section.capitalize, catalog_index_path(@section) %></p>
  <h1><%= catalog_title(@entry) %></h1>
  <% unless @entry.is_a?(Artist) %><p><%= catalog_artists(@entry).presence || "Artist credits pending" %></p><% end %>
</section>
<section class="card library-card">
  <h2>Catalog import</h2>
  <p role="status"><%= import_status(@import_request, verified: @revision.present?) %></p>
  <% if @import_request&.active? && !CatalogImport.worker_enabled? %><p>Background imports are paused in this environment.</p><% end %>
  <% if @import_request&.failure.present? %><p><%= @import_request.failure %></p><% end %>
  <%= button_to (@import_request&.state == "failed" ? "Retry import" : "Import"),
      catalog_import_path(@entry) %>
  <% if @revision %>
    <details>
      <summary>Metadata provenance</summary>
      <p>MusicBrainz · <%= browser_time(@revision.created_at) %></p>
      <% if @revision.evidence["conflicts"].present? %><p>Existing values kept for review: <%= @revision.evidence["conflicts"].keys.join(", ").humanize %>.</p><% end %>
    </details>
  <% end %>
</section>
<% case @entry
   when Artist %><%= render "artist" %>
<% when Release %><%= render "release" %>
<% when Recording %><%= render "recording" %>
<% end %>
