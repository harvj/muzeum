<%= tag.section class: "intro catalog-heading", data: musical_identity_attributes(@entry) do %>
  <p class="entity-heading-label"><span class="section-heading"><%= @entry.model_name.human %></span></p>
  <h1><%= musical_identity_badge(@entry, detailed: true) %><%= catalog_title(@entry) %>
    <%= catalog_release_date(@entry) if @entry.is_a?(Release) %></h1>
  <% case @entry
     when Release, Recording %>
    <p><span class="catalog-credit"><%= catalog_artists(@entry, badges: false).presence || "Artist credits pending" %></span></p>
    <% if @entry.is_a?(Recording) %><p><span class="catalog-credit">Recording duration <%= recording_duration(@entry.duration_ms) %></span></p><% end %>
  <% when Artist %>
    <% if @entry.country.present? %><p><span class="catalog-credit"><%= render "shared/geographic_place", country: @entry.country %></span></p><% end %>
  <% end %>
<% end %>
<%= render "listening_history", metric: (@entry.is_a?(Recording) ? :plays : :milliseconds) %>
<%= render @entry.model_name.singular %>
<%= render "recording_chronology" if @entry.is_a?(Recording) %>
<%= render "entity_details" if !@public_profile || @timeline.present? || @plays.present? || @entry.is_a?(Artist) %>
