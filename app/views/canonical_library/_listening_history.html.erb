<% anchor = @entry.is_a?(Artist) ? "listening-history" : "listening-activity" %>
<section class="card library-card entity-history" id="<%= anchor %>">
  <h2 class="section-heading"><%= @activity_releases&.many? ? "Combined listening history" : "Listening history" %></h2>
  <% if @archive_available %>
    <% if @activity_releases&.many? %>
      <p><%= safe_join(@activity_releases.map { |release| catalog_link(release) }, ", ") %></p>
    <% end %>
    <p>
      <% if @entry.is_a?(Recording) %>
        <strong><%= pluralize(@listening_total.plays, "resolved listening observation") %></strong> · <%= estimated_listening_time(@listening_total) %> estimated listening time
      <% else %>
        <strong><%= estimated_listening_time(@listening_total) %></strong> estimated listening time ·
        <%= pluralize(@listening_total.plays, @entry.is_a?(Release) ? "distinct resolved observation" : "resolved play") %>
      <% end %>
      <span class="muted">(all time)</span>
    </p>
    <%= render "duration_coverage", totals: @listening_total %>
    <div class="listening-controls">
      <% options = request.query_parameters.slice("recording_sort", "recording_page", "after_appearance", "after_track", "after_legacy_track", "with_release", "edition_tracks").merge(range: @history_range, grouping: @history_grouping, anchor: anchor) %>
      <% [[:range, "Period", { "all" => "All", "year" => "Year", "90d" => "90d", "30d" => "30d" }, @history_range],
          [:grouping, "Group by", CatalogListening::GROUPINGS.keys.index_with(&:capitalize), @history_grouping]].each do |key, heading, choices, selected| %>
        <div class="listening-control">
          <span class="muted"><%= heading %></span>
          <nav aria-label="Listening history <%= key == :range ? 'period' : 'grouping' %>" class="artist-ranges">
            <% choices.each do |value, label| %>
              <%= link_to label, catalog_entry_path(@entry, **options.merge(key => value)), aria: { current: ("true" if value == selected) } %>
            <% end %>
          </nav>
        </div>
      <% end %>
    </div>
    <% if @timeline.any? %>
      <%= render "listening_timeline", metric: %>
    <% else %>
      <p>No resolved plays in this period.</p>
    <% end %>
  <% else %>
    <p>Listening history is unavailable.</p>
  <% end %>
</section>
