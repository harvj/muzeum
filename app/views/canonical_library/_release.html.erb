<section class="card library-card music-sheet" data-controller="play-titles"
    data-action="pointerover->play-titles#preview pointerout->play-titles#leave focusin->play-titles#preview focusout->play-titles#leave keydown.esc@window->play-titles#hide scroll@window->play-titles#hide">
  <div class="plays-tooltip" popover="manual" aria-hidden="true" data-play-titles-target="tooltip"></div>
  <h2>Track listing</h2>
  <p><%= [@entry.release_year, @entry.release_month&.to_s&.rjust(2, "0"), @entry.release_day&.to_s&.rjust(2, "0")].compact.join("-").presence || "Date unknown" %>
    · <%= render "shared/geographic_place", country: @entry.catalog_country %></p>
  <% if @slots.any? %>
    <%= dense_table("Track listing", classes: "release-tracks") do %>
      <thead><tr><th scope="col" class="track-number" aria-label="Track number">#</th><th scope="col">Recording</th><th scope="col" class="table-number">Length</th><th scope="col" class="table-number">Resolved plays</th></tr></thead>
      <tbody>
        <% @slots.each.with_index(@track_offset.to_i + 1) do |slot, number| %>
          <tr><td class="track-number"><%= number %></td>
            <th scope="row"><span class="play-name" data-overflow-name><%= catalog_link(slot.recording, title: slot.title) %></span></th>
            <td class="table-number"><%= recording_duration(slot.recording.duration_ms) if slot.recording.duration_ms %></td>
            <td class="table-number">
              <% count = @track_counts.fetch(slot.recording_id, 0) %>
              <% if @archive_available && count.positive? %>
                <%= entity_link number_with_delimiter(count), catalog_entry_path(slot.recording, anchor: "listening-activity") %>
              <% else %>
                <%= @archive_available ? 0 : "Unavailable" %>
              <% end %>
            </td></tr>
        <% end %>
      </tbody>
    <% end %>
    <% if @next_track %><p><%= link_to "More tracks", catalog_entry_path(@entry, after_track: @next_track) %></p><% end %>
  <% elsif @legacy_slots.present? %>
    <p>Earlier catalog listing. Verify the full edition with Import.</p>
    <ol class="catalog-list">
      <% @legacy_slots.each do |slot| %><li><%= catalog_link(slot.recording) %></li><% end %>
    </ol>
    <% if @next_legacy_track %><p><%= link_to "More earlier tracks", catalog_entry_path(@entry, after_legacy_track: @next_legacy_track) %></p><% end %>
  <% else %>
    <p>No verified track listing is available.</p>
  <% end %>
</section>

<% if @additional_appearances.any? %>
  <section class="card library-card">
    <h2>Additional edition appearances</h2>
    <ul class="catalog-list">
      <% @additional_appearances.each do |slot| %>
        <li><%= catalog_link(slot.recording, title: slot.title) %> · <%= slot.appearance_date %> ·
          <%= link_to "MusicBrainz edition", "https://musicbrainz.org/release/#{slot.edition_mbid}" %>
          · Disc <%= slot.medium %>, track <%= slot.number.presence || slot.position %></li>
      <% end %>
    </ul>
  </section>
<% end %>

<section class="card library-card" id="listening-activity">
  <h2><%= @activity_releases.many? ? "Combined listening history" : "Release listening history" %></h2>
  <% if @activity_releases.many? %>
    <p><%= safe_join(@activity_releases.map { |release| catalog_link(release) }, ", ") %></p>
  <% end %>
  <% if @archive_available %>
    <p><strong><%= estimated_listening_time(@listening_total) %></strong> estimated listening time</p>
    <%= render "duration_coverage", totals: @listening_total %>
    <%= render "artist_timeline", metric: :milliseconds if @timeline&.any? { |_, totals| totals.plays.positive? } %>
    <p><%= pluralize(@observation_count, "distinct resolved observation") %> across the member recordings.</p>
    <% if @plays.any? %>
      <ol class="catalog-list">
        <% @plays.each do |play| %>
          <li><%= @public_profile ? browser_time(play.played_at) : entity_link(browser_time(play.played_at), resolution_surface_path(play)) %>
            · <%= catalog_link(@activity_recordings.fetch(play.effective_recording_id)) %></li>
        <% end %>
      </ol>
      <% if @next_release_play %>
        <p><%= link_to "Older observations", catalog_entry_path(@entry, before_play: @next_release_play, with_release: @activity_releases.reject { |release| release == @entry }.map(&:id), anchor: "listening-activity") %></p>
      <% end %>
    <% end %>
  <% else %>
    <p>Listening history is unavailable.</p>
  <% end %>
</section>
