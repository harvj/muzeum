<section class="card library-card music-sheet" data-controller="play-titles"
    data-action="pointerover->play-titles#preview pointerout->play-titles#leave focusin->play-titles#preview focusout->play-titles#leave keydown.esc@window->play-titles#hide scroll@window->play-titles#hide">
  <div class="plays-tooltip" popover="manual" aria-hidden="true" data-play-titles-target="tooltip"></div>
  <h2 class="section-heading">Track listing</h2>
  <p><%= [@entry.release_year, @entry.release_month&.to_s&.rjust(2, "0"), @entry.release_day&.to_s&.rjust(2, "0")].compact.join("-").presence || "Date unknown" %>
    · <%= render "shared/geographic_place", country: @entry.catalog_country %></p>
  <% if @slots.any? %>
    <% colors = musical_identity_attributes(@entry) %>
    <% maximum = @track_counts.values.max.to_i %>
    <%= dense_table("Track listing", classes: "release-tracks") do %>
      <thead><tr><th scope="col" class="track-number" aria-label="Track number">#</th><th scope="col">Recording</th><th scope="col" class="table-number">Length</th><th scope="col" class="track-play-count">Resolved plays</th></tr></thead>
      <tbody>
        <% @slots.each.with_index(@track_offset.to_i + 1) do |slot, number| %>
          <tr><td class="track-number"><%= number %></td>
            <th scope="row"><span class="play-name" data-overflow-name><%= catalog_link(slot.recording, title: slot.title) %></span></th>
            <td class="table-number"><%= recording_duration(slot.duration_ms || slot.recording.duration_ms) %></td>
            <td class="track-play-count">
              <% if @archive_available && !@counted_tracks.include?(slot.recording_id) %>
                Excluded
              <% elsif @archive_available %>
                <% count = @track_counts.fetch(slot.recording_id, 0) %>
                <%= render "listening_bar", value: count, maximum:, label: number_with_delimiter(count),
                  accessible_label: pluralize(count, "resolved play"), colors:,
                  path: catalog_entry_path(slot.recording, anchor: "listening-activity") %>
              <% else %>
                Unavailable
              <% end %>
            </td></tr>
        <% end %>
      </tbody>
    <% end %>
    <% if @next_track %><p><%= link_to "More tracks", catalog_entry_path(@entry, after_track: @next_track) %></p><% end %>
  <% elsif @legacy_slots.present? %>
    <p>Earlier catalog listing. Verify the full edition with Import.</p>
    <% first = @legacy_slots.first %>
    <% start = @entry.release_recordings.where("(position, id) < (?, ?)", first.position, first.id).count + 1 %>
    <ol class="catalog-list" start="<%= start %>">
      <% @legacy_slots.each do |slot| %><li><%= catalog_link(slot.recording) %></li><% end %>
    </ol>
    <% if @next_legacy_track %><p><%= link_to "More earlier tracks", catalog_entry_path(@entry, after_legacy_track: @next_legacy_track) %></p><% end %>
  <% else %>
    <p>No verified track listing is available.</p>
  <% end %>
</section>

<% groups_by_mbid = @additional_edition_evidence.to_h { |track| track.values_at("recording_mbid", "comparison_group") } %>
<% admitted = @additional_appearances.group_by { |slot| groups_by_mbid.fetch(slot.evidence_recording_mbid, slot.evidence_recording_mbid) } %>
<% evidence = @additional_edition_evidence.group_by { |track| track.fetch("comparison_group") } %>
<% additional_mbids = admitted.keys | evidence.keys %>
<% if additional_mbids.any? %>
  <section class="card library-card">
    <details class="additional-edition-tracks">
      <summary><strong>Additional edition tracks</strong> <span class="muted"><%= pluralize(additional_mbids.size, "track") %></span></summary>
      <ul class="catalog-list">
        <% additional_mbids.each do |mbid| %>
          <% slots = admitted.fetch(mbid, []) %>
          <% sources = (slots.map { |slot| [slot.edition_mbid, slot.appearance_date] } + evidence.fetch(mbid, []).map { |track| track.values_at("edition_mbid", "edition_appearance_date") }).uniq(&:first) %>
          <% title = slots.first&.title || evidence.fetch(mbid).first.fetch("title") %>
          <li><%= slots.any? ? catalog_link(slots.first.recording, title:) : title %>
            <% if sources.first.last.present? %> · <%= sources.first.last %><% end %>
            <% version = evidence.fetch(mbid, []).find { |track| track["version"].present? }&.fetch("version") %>
            <% if version.present? %> · <%= version %><% end %>
            <% source = evidence.fetch(mbid, []).find { |track| track["source_track"].present? } %>
            <% if slots.empty? && source && @archive_available && !@public_profile %>
              <%= button_to "Include", track_listening_release_path(@entry), method: :patch,
                params: { source_recording_mbid: source.fetch("recording_mbid"), decision: "include" },
                form: { class: "release-track-preference" }, aria: { label: "Include #{title} in release listening totals" } %>
            <% end %>
            <ul>
              <% sources.each do |edition_mbid, date| %>
                <li><%= link_to ["MusicBrainz edition", date].compact.join(" · "), "https://musicbrainz.org/release/#{edition_mbid}" %></li>
              <% end %>
            </ul>
          </li>
        <% end %>
      </ul>
    </details>
  </section>
<% end %>

<section class="card library-card" id="listening-activity">
  <h2 class="section-heading"><%= @activity_releases.many? ? "Combined listening history" : "Release listening history" %></h2>
  <% if @archive_available && !@public_profile && (@slots.any? || @additional_appearances.any?) %>
    <details id="release-track-listening"<%= " open" if params[:track_preferences].present? %>>
      <summary>Tracks counted in listening totals</summary>
      <ul class="release-track-preferences">
        <% (@slots + @additional_appearances).uniq(&:recording_id).each do |track| %>
          <% counted = @counted_tracks.include?(track.recording_id) %>
          <% action = counted ? "Exclude" : "Include" %>
          <% destination = counted ? "from" : "in" %>
          <li><span><%= track.title %><%= " · Additional edition track" if track.edition_mbid %></span>
            <%= button_to action, track_listening_release_path(@entry), method: :patch,
              params: { recording_id: track.recording_id, decision: action.downcase },
              form: { class: "release-track-preference" }, aria: { label: "#{action} #{track.title} #{destination} release listening totals" } %>
          </li>
        <% end %>
      </ul>
    </details>
  <% end %>
  <% if @activity_releases.many? %>
    <p><%= safe_join(@activity_releases.map { |release| catalog_link(release) }, ", ") %></p>
  <% end %>
  <% if @archive_available %>
    <p><strong><%= estimated_listening_time(@listening_total) %></strong> estimated listening time</p>
    <%= render "duration_coverage", totals: @listening_total %>
    <%= render "artist_timeline", metric: :milliseconds if @timeline&.any? { |_, totals| totals.plays.positive? } %>
    <p><%= pluralize(@observation_count, "distinct resolved observation") %> across the counted recordings.</p>
    <% if @plays.any? %>
      <ol class="catalog-list">
        <% @plays.each do |play| %>
          <li><%= @public_profile ? browser_time(play.played_at) : entity_link(browser_time(play.played_at), resolution_surface_path(play)) %>
            · <%= catalog_link(@activity_recordings.fetch(play.effective_recording_id)) %></li>
        <% end %>
      </ol>
      <% if @next_release_play %>
        <p><%= link_to "Older observations", catalog_entry_path(@entry, before_play: @next_release_play, with_release: @activity_releases.reject { |release| release == @entry }.map(&:id), anchor: "listening-activity") %></p>
      <% end %>
    <% end %>
  <% else %>
    <p>Listening history is unavailable.</p>
  <% end %>
</section>
