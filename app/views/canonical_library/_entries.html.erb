<%= dense_table(title) do %>
  <thead>
    <tr>
      <th scope="col"><%= title.singularize %></th>
      <% if title != "Artists" %><th scope="col">Artist credits</th><% end %>
      <% case title
         when "Artists" %><th scope="col">Origin</th>
      <% when "Releases" %><th scope="col" class="table-number">Year</th>
      <% when "Recordings" %><th scope="col" class="table-number">Length</th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% items.each do |item| %>
      <tr>
        <th scope="row"><%= catalog_link(item) %></th>
        <% unless item.is_a?(Artist) %><td><%= catalog_artists(item).presence || "Pending" %></td><% end %>
        <% case item
           when Artist %>
          <% evidence = @geographies&.fetch(item.id, nil)&.evidence %>
          <td class="compact-meta"><%= render "shared/geographic_place",
            place: (evidence["origin"] if evidence&.fetch("status") == "verified"), country: item.country %></td>
        <% when Release %><td class="table-number"><%= item.release_year || "Unknown" %></td>
        <% when Recording %><td class="table-number"><%= recording_duration(item.duration_ms) %></td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
<% end %>
