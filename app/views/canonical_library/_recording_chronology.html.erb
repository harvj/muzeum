<section class="card library-card" id="recording-chronology">
  <h2 class="section-heading">Chronology</h2>
  <% dates = @chronology&.evidence || {} %>
  <dl>
    <div><dt>Recording date</dt><dd><%= [dates["start_date"], dates["end_date"]].compact.join(" to ").presence || "Unknown" %></dd></div>
    <% if @verified_first_release %>
      <div><dt>Earliest verified publication</dt><dd><%= @verified_first_release %></dd></div>
    <% else %>
    <div><dt>First release date reported by MusicBrainz</dt><dd><%= @first_release_claim.presence || "Unknown" %></dd></div>
    <% end %>
  </dl>
  <% if dates["source"].present? && !@public_profile %><p>Recording date source: <%= dates["source"] %></p><% end %>
  <% if @may_edit_identity %>
    <details>
      <summary>Correct recording date</summary>
      <%= form_with scope: :chronology, url: chronology_recording_path(@entry), method: :patch do |form| %>
        <%= form.hidden_field :head, value: @chronology&.id %>
        <%= form.label :start_date, "Recording date or range start (YYYY, YYYY-MM, or YYYY-MM-DD)" %>
        <%= form.text_field :start_date, value: dates["start_date"], maxlength: 10 %>
        <%= form.label :end_date, "Range end, if known" %>
        <%= form.text_field :end_date, value: dates["end_date"], maxlength: 10 %>
        <%= form.label :source, "Source or reason the date is unknown" %>
        <%= form.text_area :source, maxlength: 1000, required: true %>
        <%= form.submit "Save recording date" %>
      <% end %>
    </details>
  <% end %>
</section>
