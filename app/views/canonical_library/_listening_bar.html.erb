<% if value.positive? %>
  <%= tag.div class: "listening-bar", data: { controller: "listening-scale",
    listening_scale_percent_value: 100.0 * value / maximum, **local_assigns.fetch(:colors, {}) } do %>
    <span aria-label="<%= accessible_label %>"><%= label %></span>
  <% end %>
<% else %>
  <span aria-label="<%= accessible_label %>"><%= label %></span>
<% end %>
