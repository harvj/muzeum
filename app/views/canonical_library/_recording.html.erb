<% if @recording_chronology %>
  <section class="card library-card" id="recording-chronology">
    <h2>Chronology</h2>
    <dl>
      <div><dt>Recording date</dt><dd><%= @recording_chronology.values_at("start_date", "end_date").compact.join(" to ").presence || "Unknown" %></dd></div>
      <div><dt>First release date reported by MusicBrainz</dt><dd><%= @first_release_claim.presence || "Unknown" %></dd></div>
    </dl>
  </section>
<% end %>
<% unless Clients::Musicbrainz::MBID.match?(@entry.mbid.to_s) %>
  <p class="muted">Partially resolved · The provider identity is unverified.</p>
<% end %>
<% if @releases.any? %>
  <%= render "related", title: "Release appearances", items: @releases %>
  <% if @next_appearance %><p><%= link_to "More release appearances", catalog_entry_path(@entry, after_appearance: @next_appearance, before: params[:before]) %></p><% end %>
<% else %>
  <section class="card library-card">
    <h2>Release appearances</h2>
    <p>Release memberships pending verification.</p>
  </section>
<% end %>
<section class="card library-card" id="listening-activity">
  <h2>Listening activity</h2>
  <p>Recording duration <%= recording_duration(@entry.duration_ms) %></p>
  <% if @archive_available %>
    <p><strong><%= pluralize(@observation_count, "resolved listening observation") %></strong></p>
    <p>Estimated listening time: <%= estimated_listening_time(@listening_total) %></p>
    <%= render "duration_coverage", totals: @listening_total %>
    <% unless @public_profile %><p class="muted">Unresolved observations are outside this count.</p><% end %>
    <% if @plays.any? %>
      <%= dense_table("Listening activity") do %>
        <thead><tr><th scope="col">Played at</th></tr></thead>
        <tbody>
          <% @plays.each do |play| %>
            <tr><th scope="row"><% if @public_profile %>
              <%= browser_time(play.played_at) %>
            <% else %>
              <%= entity_link browser_time(play.played_at), resolution_surface_path(play) %>
            <% end %></th></tr>
          <% end %>
        </tbody>
      <% end %>
      <% if @next_page %><p><%= link_to "Older observations", catalog_entry_path(@entry, before: @next_page) %></p><% end %>
    <% end %>
  <% else %>
    <p>Listening activity is unavailable until you connect a Last.fm archive.</p>
  <% end %>
</section>
