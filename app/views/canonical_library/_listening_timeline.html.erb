<% counts = metric == :plays %>
<% maximum = @timeline.map { |_, totals| totals.public_send(metric) }.max %>
<% peak = counts ? number_with_delimiter(maximum) : compact_listening_time(maximum) %>
<% minimum = counts ? "0" : "0 min" %>
<% colors = @activity_releases&.many? ? {} : musical_identity_attributes(@entry) %>
<% desktop_labels = listening_calendar_labels(@timeline, @history_grouping, spacing: 5) %>
<% mobile_labels = listening_calendar_labels(@timeline, @history_grouping, spacing: 3, from_newest: true) %>
<%= tag.figure class: "artist-timeline identity-chart", data: colors,
  aria: { label: counts ? "Plays by date" : "Estimated listening time by date" } do %>
  <div class="artist-timeline-axis" aria-hidden="true">
    <% if maximum.positive? %><span class="listening-axis-peak"><%= peak %></span><% end %>
    <span class="listening-axis-zero"><%= minimum %></span>
  </div>
  <div class="listening-plot" tabindex="0" role="region" aria-label="Listening chart. Exact values are available in Details.">
    <div class="artist-timeline-bars" aria-hidden="true">
      <% @timeline.each_with_index do |(date, totals), index| %>
        <% value = totals.public_send(metric) %>
        <div class="artist-timeline-column" data-date="<%= date.iso8601 %>">
          <% if value.positive? %>
            <div class="artist-timeline-fill" data-controller="listening-scale" data-listening-scale-percent-value="<%= 100.0 * value / maximum %>" title="<%= date.iso8601 %> · <%= counts ? pluralize(totals.plays, "play") : estimated_listening_time(totals) %>"></div>
          <% end %>
          <% if (label = desktop_labels[index]) %><time class="listening-label-desktop" datetime="<%= date.iso8601 %>"><%= label %></time><% end %>
          <% if (label = mobile_labels[index]) %><time class="listening-label-mobile" datetime="<%= date.iso8601 %>"><%= label %></time><% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
