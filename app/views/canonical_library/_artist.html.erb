<section class="card library-card artist-history" id="listening-history">
  <div class="artist-history-heading">
    <div>
      <h2>Listening history</h2>
      <% if @archive_available %>
        <p><strong><%= estimated_listening_time(@listening_total) %></strong> estimated listening time · <%= pluralize(@listening_total.plays, "resolved play") %></p>
        <%= render "duration_coverage", totals: @listening_total %>
      <% end %>
    </div>
    <% if @archive_available %>
      <nav aria-label="Listening history period" class="artist-ranges">
        <% { "all" => "All", "year" => "Year", "90d" => "90d", "30d" => "30d" }.each do |range, label| %>
          <%= link_to label, catalog_entry_path(@entry, **request.query_parameters.slice("recording_sort", "recording_page").merge(range: range, anchor: "listening-history")),
            aria: { current: ("true" if range == @history_range) } %>
        <% end %>
      </nav>
    <% end %>
  </div>
  <% if @archive_available && @timeline.any? { |_, totals| totals.plays.positive? } %>
    <%= render "artist_timeline" %>
  <% else %>
    <p><%= @archive_available ? "No resolved plays in this period." : "Listening history is unavailable." %></p>
  <% end %>
</section>
<section class="card library-card" id="artist-recordings">
  <h2>Recordings (<%= @recording_count %>)</h2>
  <% if @recording_rows.any? %>
    <table class="artist-listening-table artist-recordings">
      <thead><tr>
        <% { "title" => "Title", "length" => "Length", "recent" => "Last listened", "plays" => "Play count" }.each do |sort, label| %>
          <th scope="col" aria-sort="<%= (@recording_sort == sort ? (sort == "title" ? "ascending" : "descending") : "none") %>">
            <%= link_to label, catalog_entry_path(@entry, range: @history_range, recording_sort: sort, anchor: "artist-recordings") %>
          </th>
        <% end %>
      </tr></thead>
      <tbody>
        <% @recording_rows.each do |recording, totals| %>
          <tr>
            <td><%= catalog_link(recording) %></td>
            <td><%= recording_duration(recording.duration_ms) %></td>
            <td><%= browser_time(totals.last_played, date_only: true) if totals.last_played %></td>
            <td><%= render "listening_bar", value: totals.plays, maximum: @play_bar_max, label: totals.plays, accessible_label: pluralize(totals.plays, "play") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @recording_page.positive? %>
      <%= link_to "Previous recordings", catalog_entry_path(@entry, range: @history_range, recording_sort: @recording_sort, recording_page: @recording_page - 1, anchor: "artist-recordings") %>
    <% end %>
    <% if (@recording_page + 1) * 10 < @recording_count %>
      <%= link_to "More recordings", catalog_entry_path(@entry, range: @history_range, recording_sort: @recording_sort, recording_page: @recording_page + 1, anchor: "artist-recordings") %>
    <% end %>
  <% else %>
    <p>No canonical recordings are available.</p>
  <% end %>
</section>
<section class="card library-card" id="artist-releases">
  <h2>Ranked releases (<%= @release_rows.size %>)</h2>
  <% if @release_rows.any? %>
    <table class="artist-listening-table artist-releases">
      <thead><tr><th scope="col">Release</th><th scope="col">Year</th><th scope="col" aria-sort="descending">Estimated listening time</th></tr></thead>
      <tbody>
        <% @release_rows.each do |release, totals| %>
          <tr><td><%= catalog_link(release) %></td><td><%= release.release_year %></td>
            <td>
              <% duration = estimated_listening_time(totals) %>
              <%= render "listening_bar", value: totals.milliseconds, maximum: @time_bar_max, label: duration,
                accessible_label: "#{duration}, #{pluralize(totals.plays, 'play')}" %>
              <small><%= pluralize(totals.plays, "play") %></small>
              <% if totals.known_durations < totals.plays %><small><%= duration_coverage(totals) %></small><% end %>
            </td></tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No releases qualify for these rankings.</p>
  <% end %>
</section>
