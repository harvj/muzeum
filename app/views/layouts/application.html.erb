<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Muzeum — listening archive</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/identity/v1/identity.css">
    <link rel="stylesheet" href="/identity/v1/session.css">
    <link rel="stylesheet" href="/environments/stone/environment.css">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <div class="stone-environment" aria-hidden="true"></div>
    <header>
      <a class="harvj-wordmark" href="/">muzeum</a>
      <div class="header-navigation">
        <% if current_user %>
          <nav class="library-nav" aria-label="Music library">
            <% { "Recordings" => recordings_path, "Releases" => releases_path, "Artists" => artists_path,
                 "Archive" => root_path, "Resolution" => resolution_surfaces_path }.each do |label, path| %>
              <% active = path == root_path ? current_page?(path) : request.path.start_with?(path) %>
              <%= link_to label, path, class: "entity-link", aria: { current: active ? "page" : nil } %>
            <% end %>
          </nav>
          <div class="account-nav" aria-label="Profile"><%= render "shared/session_dropdown" %></div>
        <% else %>
          <div class="account-nav"><%= render "shared/appearance" %></div>
        <% end %>
      </div>
    </header>
    <main>
      <% flash.each do |_, message| %><p class="card flash" role="status"><%= message %></p><% end %>
      <%= yield %>
      <footer class="site-footer">© 2026 Jim Harvey</footer>
    </main>
  </body>
</html>
