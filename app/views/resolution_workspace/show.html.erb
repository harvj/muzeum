<% section = params[:section].presence_in(%w[evidence observations history]) || "candidates" %>
<% contexts = resolution_release_contexts(@assessment, @candidates) %>
<% selected = resolution_selected_candidate(@candidates, @ranking, contexts, params[:candidate], @current_recording&.mbid) %>
<% explicit_candidate = @candidates.any? { |candidate| candidate["id"] == params[:candidate] } %>
<% selected = nil if @release_review&.policy && !explicit_candidate %>
<% navigation = { assessment: params[:assessment].presence, candidate: params[:candidate].presence }.compact %>
<% if @assessment_request&.active? && params[:assessment].blank? && !@assessment_request.expired_investigation? %>
  <% check_at = @assessment_request.state == "refreshing" ? @assessment_request.lease_until : @assessment_request.due_at %>
  <div id="investigation-stream-<%= @assessment_request.id %>" hidden data-controller="investigation-sync"
    data-investigation-sync-pending-value="<%= @assessment_request.state == "pending" %>"
    data-investigation-sync-check-at-value="<%= check_at&.iso8601(3) %>"
    data-action="turbo:before-morph-attribute->investigation-sync#preserveConnection">
    <%= turbo_stream_from @assessment_request %>
  </div>
<% end %>
<div class="card library-card resolution-review">
<div class="review-overview">
<section class="review-heading">
  <% review_state = if @current_recording
      Clients::Musicbrainz::MBID.match?(@current_recording.mbid.to_s) ? "Resolved" : "Partially resolved"
    else
      @unresolved_count.zero? ? "Individually resolved" : (resolution_distinct_recording_count(@assessment, @candidates) > 1 ? "Ambiguous" : "Unresolved")
    end %>
  <strong class="review-state<%= " review-state-resolved" if review_state == "Resolved" %>"><%= review_state %></strong>
  <% source = @selected_scrobble || @observation %>
  <p class="review-back"><%= link_to "Recording resolution", resolution_surfaces_path %> / Observation <%= source.id %></p>
  <h1><%= observed_text(source.payload["track_name"], "Track") %></h1>
  <p class="review-string-label">Recording string</p>
  <% if (interpretation = @assessment&.evidence&.fetch("title_interpretation", nil)) && interpretation["original_title"] == source.payload["track_name"] %>
    <details class="review-observation-meta">
      <summary><%= interpretation["base_title"] %> — <%= interpretation["descriptors"].map { |descriptor| descriptor["kind"] == "mastering" ? [ descriptor["year"], descriptor["name"] ].compact.join(" ") : descriptor["text"] }.join(", ") %></summary>
      <p>Search interpretation from the reported title. Recording identity still requires catalog evidence.</p>
      <% if interpretation["unclassified"].present? %><p>Unclassified title text: <%= interpretation["unclassified"].join(", ") %>.</p><% end %>
    </details>
  <% end %>
  <dl class="review-source-claims">
    <% %w[Artist Album].each do |label| %>
      <div><dt><%= label %> string</dt><dd><%= observed_text(source.payload["#{label.downcase}_name"], label) %></dd></div>
    <% end %>
  </dl>
  <p class="review-observation-meta"><%= pluralize(@observations_count, "matching observation") %></p>
</section>
<% if selected || @current_recording %>
  <% catalog_rows = selected ? @catalog_context.rows(selected) : RecordingResolution::CatalogContext.rows(@current_recording) %>
  <%= render "catalog_panel", catalog_rows: %>
<% end %>
</div>
<nav class="review-sections" aria-label="Review sections">
  <% { "candidates" => "Candidates", "evidence" => "Evidence", "observations" => "Observations (#{@observations_count})", "history" => "History" }.each do |tab, label| %>
    <%= link_to label, resolution_surface_path(@observation, **navigation.merge(section: tab == "candidates" ? nil : tab)),
      class: ("review-primary-section" if section == tab), aria: { current: ("page" if section == tab) } %>
  <% end %>
</nav>
<% if @assessment && %w[candidates evidence].include?(section) %>
  <p class="compact-meta">Last assessment <%= browser_time(@assessment.created_at) %>.
    <% if @assessment.version != RecordingResolution::Assessment::INTERPRETATION_VERSION %>Earlier investigation logic.<% end %>
    <% if @assessment.evidence["reassessment"].present? %>
      Retained evidence was reassessed.
      <% if (lookup = @assessment.evidence["reviewed_release_lookup"]) %>
        <%= pluralize(Array(lookup["attempted"]).size, "reviewed edition lookup") %> attempted.
        <%= pluralize(Array(lookup["missing"]).size, "edition lookup") %> still missing.
        <% if @assessment.evidence.fetch("reviewed_recording_browses", {}).values.any? { |browse| !browse["complete"] } %>
          Recording appearance coverage is incomplete.
        <% end %>
      <% end %>
    <% end %>
  </p>
  <% if @may_manage_observation && @assessment_matches_claims && !@assessment_request&.active? %>
    <%= button_to "Refresh investigation", investigate_resolution_surface_path(@observation),
      params: { reassess: "1", assessment_id: @assessment.id } %>
  <% end %>
<% end %>
<% if section == "candidates" || (section == "evidence" && @release_review&.policy) %>
<section id="review-candidates" class="resolution-decision" tabindex="-1"
  <% if @release_review&.policy %>data-controller="pending-release-review" data-action="change->pending-release-review#update"<% end %>>
  <% candidate_badge = nil %>
  <% position_badge = ->(badge) { candidate_badge = badge } if selected %>
  <%= render "investigation_status", contexts:, compact: true, position_badge: %>
  <%= render "recording_choices", selected:, contexts:, navigation:, catalog_rows:, candidate_badge: %>
  <% if @release_review&.policy %>
    <details class="resolution-release-evidence">
      <summary>Release configurations and adjacent programs</summary>
      <%= render "reviewed_release_programs", review: @release_review,
        allow_selection: selected.present? && @may_manage_observation && @assessment_matches_claims %>
    </details>
  <% end %>
  <% if @batch_releases.present? %>
    <details><summary>Review other tracks</summary>
      <ul><% @batch_releases.each do |release| %>
        <li><%= link_to release.title, release_batch_resolution_surface_path(@observation, release_id: release.id), data: { turbo_prefetch: false } %></li>
      <% end %></ul>
    </details>
  <% end %>
</section>
<% end %>
<% if section == "evidence" %>
<section id="review-evidence">
  <%= render "investigation_status", contexts:, compact: section == "candidates" %>
  <%= render "investigation", selected:, review_state: %>
  <% if @adjacent_programs.present? && !@release_review&.policy %>
    <details>
      <summary>Review independently issued releases</summary>
      <p>These official programs contain an exact checked recording. Their earliest supported appearance may change as more evidence becomes available. Leave them here to retain them as evidence.</p>
      <% @adjacent_programs.each do |mbid, edition| %>
        <details>
          <summary><%= [edition["title"], edition.dig("release-group", "primary-type"), edition["country"], edition["date"]].compact.join(" · ") %></summary>
          <% history = @assessment.evidence.fetch("additional_recording_publications", {}).fetch(mbid, {}) %>
          <p>Checked recording <%= link_to history.dig("exact_recording", "title").presence || mbid, "https://musicbrainz.org/recording/#{mbid}" %>
            appears on this independent program.</p>
          <% if history["incomplete"] %>
            <p>Investigation incomplete. <%= Array(history["limitations"]).join(" ") %></p>
          <% end %>
          <p><%= link_to "MusicBrainz source release", "https://musicbrainz.org/release/#{edition.fetch("id")}" %></p>
          <% edition.fetch("media").sort_by { |medium| medium.fetch("position") }.each do |medium| %>
            <p>Medium <%= medium.fetch("position") %></p>
            <ol>
              <% medium.fetch("tracks").sort_by { |track| track.fetch("position") }.each do |track| %>
                <li value="<%= track.fetch("position") %>"><%= track.fetch("title") %></li>
              <% end %>
            </ol>
          <% end %>
          <%= button_to "Admit this release", admit_adjacent_release_resolution_surface_path(@observation),
            params: { assessment_id: @assessment.id, recording_mbid: mbid, edition_mbid: edition.fetch("id") } %>
        </details>
      <% end %>
    </details>
  <% end %>
  <% if @release_configurations.present? && !@release_review&.policy %>
    <details>
      <summary>Retain verified release configurations</summary>
      <p>Retaining a source tracklist preserves evidence. It does not admit recordings or change a listener’s preference.</p>
      <% @release_configurations.each do |release, edition| %>
        <%= button_to ["Retain", release.title, edition["country"], edition["date"], edition["id"]].compact.join(" · "),
          retain_configuration_resolution_surface_path(@observation),
          params: { assessment_id: @assessment.id, edition_mbid: edition["id"] } %>
      <% end %>
    </details>
  <% end %>
</section>
<% end %>

<% if section == "observations" %>
<section class="review-secondary" id="review-observations">
  <h2 class="section-heading">Matching observations</h2>
  <%= dense_table("Matching observations") do %>
    <thead><tr><th scope="col">Played at</th><th scope="col">Effective recording</th><th scope="col">Scope</th></tr></thead>
    <tbody>
      <% @scrobbles.each do |play| %>
        <% head = @exception_heads[play.id] %>
        <tr>
          <th scope="row"><%= entity_link browser_time(play.played_at), resolution_surface_path(play) %></th>
          <td><%= @recordings[play.effective_recording_id] ? catalog_link(@recordings.fetch(play.effective_recording_id)) : "Unresolved" %></td>
          <td class="compact-meta"><%= head && head.mode != "inherit" ? "One observation" : "Inherited" %></td>
        </tr>
      <% end %>
    </tbody>
  <% end %>
  <% if @next_scrobble %><p><%= link_to "Older observations", resolution_surface_path(@observation, before: @next_scrobble, section: "observations", assessment: navigation[:assessment], candidate: navigation[:candidate]) %></p><% end %>
</section>
<% elsif section == "history" %>
<section class="review-secondary" id="review-history">
  <h2 class="section-heading">Decision history</h2>
  <% if @history.any? %>
    <ul class="catalog-list">
      <% @history.each do |decision| %>
        <li><%= browser_time(decision.created_at) %> · <%= decision.user_id ? "Your decision" : "Automatic decision" %>
          · <%= decision.scrobble_id ? "One observation" : "Surface" %> · <%= decision.mode.humanize %>
          <% if decision.recording_id %> · <%= catalog_link(@recordings.fetch(decision.recording_id)) %><% end %>
          <% if decision.assessment_id %> · <%= link_to "Assessment", resolution_surface_path(@observation, assessment: decision.assessment_id, play: decision.scrobble_id, section: "evidence") %><% end %>
          <br><%= decision.reason %><% if decision.evidence["comment"].present? %> · <%= decision.evidence["comment"] %><% end %></li>
      <% end %>
    </ul>
    <% if @next_history %><p><%= link_to "Earlier decisions", resolution_surface_path(@observation, history_before: @next_history, section: "history") %></p><% end %>
  <% else %><p>No decisions yet.</p><% end %>
</section>
<% end %>
</div>
