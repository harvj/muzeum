<% section = params[:section].presence_in(%w[evidence observations history]) || "candidates" %>
<% contexts = resolution_release_contexts(@assessment, @candidates) %>
<% selected = resolution_selected_candidate(@candidates, @ranking, contexts, params[:candidate], @current_recording&.mbid) %>
<% navigation = { assessment: params[:assessment].presence, candidate: params[:candidate].presence }.compact %>
<%= turbo_stream_from @assessment_request if @assessment_request&.active? && params[:assessment].blank? %>
<div class="card library-card resolution-review">
<div class="review-overview">
<section class="review-heading">
  <% review_state = if @current_recording
      Clients::Musicbrainz::MBID.match?(@current_recording.mbid.to_s) ? "Resolved" : "Partially resolved"
    else
      @unresolved_count.zero? ? "Individually resolved" : (@candidates.many? ? "Ambiguous" : "Unresolved")
    end %>
  <strong class="review-state<%= " review-state-resolved" if review_state == "Resolved" %>"><%= review_state %></strong>
  <% source = @selected_scrobble || @observation %>
  <p class="review-back"><%= link_to "Recording resolution", resolution_surfaces_path %> / Observation <%= source.id %></p>
  <h1><%= observed_text(source.payload["track_name"], "Track") %></h1>
  <p class="review-string-label">Recording string</p>
  <dl class="review-source-claims">
    <% %w[Artist Album].each do |label| %>
      <div><dt><%= label %> string</dt><dd><%= observed_text(source.payload["#{label.downcase}_name"], label) %></dd></div>
    <% end %>
  </dl>
  <p class="review-observation-meta"><%= pluralize(@observations_count, "matching observation") %></p>
</section>
<% if selected || @current_recording %>
  <% catalog_rows = selected ? @catalog_context.rows(selected) : RecordingResolution::CatalogContext.rows(@current_recording) %>
  <%= render "catalog_panel", catalog_rows: %>
<% end %>
</div>
<nav class="review-sections" aria-label="Review sections">
  <% { "candidates" => "Candidates", "evidence" => "Evidence", "observations" => "Observations (#{@observations_count})", "history" => "History" }.each do |tab, label| %>
    <%= link_to label, resolution_surface_path(@observation, **navigation.merge(section: tab == "candidates" ? nil : tab)),
      class: ("review-primary-section" if section == tab), aria: { current: ("page" if section == tab) } %>
  <% end %>
</nav>
<% if section == "candidates" %>
<section id="review-candidates" class="resolution-decision" tabindex="-1">
  <%= render "investigation_status", contexts:, compact: section == "candidates" %>
  <%= render "recording_choices", selected:, contexts:, navigation:, catalog_rows: %>
  <% if @batch_releases.present? %>
    <details><summary>Review other tracks</summary>
      <ul><% @batch_releases.each do |release| %>
        <li><%= link_to release.title, release_batch_resolution_surface_path(@observation, release_id: release.id), data: { turbo_prefetch: false } %></li>
      <% end %></ul>
    </details>
  <% end %>
</section>
<% elsif section == "evidence" %>
<section id="review-evidence">
  <%= render "investigation_status", contexts:, compact: section == "candidates" %>
  <%= render "investigation", selected:, review_state: %>
</section>
<% end %>

<% if section == "observations" %>
<section class="review-secondary" id="review-observations">
  <h2 class="section-heading">Matching observations</h2>
  <%= dense_table("Matching observations") do %>
    <thead><tr><th scope="col">Played at</th><th scope="col">Effective recording</th><th scope="col">Scope</th></tr></thead>
    <tbody>
      <% @scrobbles.each do |play| %>
        <% head = @exception_heads[play.id] %>
        <tr>
          <th scope="row"><%= entity_link browser_time(play.played_at), resolution_surface_path(play) %></th>
          <td><%= @recordings[play.effective_recording_id] ? catalog_link(@recordings.fetch(play.effective_recording_id)) : "Unresolved" %></td>
          <td class="compact-meta"><%= head && head.mode != "inherit" ? "One observation" : "Inherited" %></td>
        </tr>
      <% end %>
    </tbody>
  <% end %>
  <% if @next_scrobble %><p><%= link_to "Older observations", resolution_surface_path(@observation, before: @next_scrobble, section: "observations", assessment: navigation[:assessment], candidate: navigation[:candidate]) %></p><% end %>
</section>
<% elsif section == "history" %>
<section class="review-secondary" id="review-history">
  <h2 class="section-heading">Decision history</h2>
  <% if @history.any? %>
    <ul class="catalog-list">
      <% @history.each do |decision| %>
        <li><%= browser_time(decision.created_at) %> · <%= decision.user_id ? "Your decision" : "Automatic decision" %>
          · <%= decision.scrobble_id ? "One observation" : "Surface" %> · <%= decision.mode.humanize %>
          <% if decision.recording_id %> · <%= catalog_link(@recordings.fetch(decision.recording_id)) %><% end %>
          <% if decision.assessment_id %> · <%= link_to "Assessment", resolution_surface_path(@observation, assessment: decision.assessment_id, play: decision.scrobble_id, section: "evidence") %><% end %>
          <br><%= decision.reason %><% if decision.evidence["comment"].present? %> · <%= decision.evidence["comment"] %><% end %></li>
      <% end %>
    </ul>
    <% if @next_history %><p><%= link_to "Earlier decisions", resolution_surface_path(@observation, history_before: @next_history, section: "history") %></p><% end %>
  <% else %><p>No decisions yet.</p><% end %>
</section>
<% end %>
</div>
