<section class="intro">
  <p><%= link_to "Recording resolution", resolution_surfaces_path %></p>
  <h1><%= observed_text(@observation.payload["track_name"], "Track") %></h1>
  <p><%= observed_text(@observation.payload["artist_name"], "Artist") %> · <%= observed_text(@observation.payload["album_name"], "Album") %></p>
  <p><%= pluralize(@observations_count, "observation") %> with these exact Last.fm strings.</p>
</section>
<section class="card library-card">
  <h2>Current surface assignment</h2>
  <% if @inherited_head&.recording_id %>
    <p><%= catalog_link(Recording.find(@inherited_head.recording_id)) %></p>
  <% else %>
    <p><%= @inherited_head&.mode == "unresolved" ? "Explicitly unresolved" : "Unresolved" %></p>
  <% end %>
  <% if @selected_scrobble %>
    <p>Effective recording for the observation at <%= browser_time(@selected_scrobble.played_at) %>
      · <%= @current_recording ? catalog_link(@current_recording) : "Unresolved" %>.</p>
    <p><%= link_to "Review the surface instead", resolution_surface_path(@observation) %></p>
  <% end %>
  <%= render "decision_controls" %>
  <details>
    <summary>Original Last.fm claims</summary>
    <% claims = (@selected_scrobble || @observation).payload.slice(*RecordingResolution::PilotRunner::CLAIM_FIELDS) %>
    <% if claims.values.any?(&:present?) %>
      <ul class="catalog-list"><% claims.each do |field, value| %><% if value.present? %><li><%= field.humanize %> <code><%= value %></code></li><% end %><% end %></ul>
    <% else %><p>No MusicBrainz IDs were supplied.</p><% end %>
  </details>
</section>

<section class="card library-card">
  <h2>Candidate recordings</h2>
  <% if @assessment_request %>
    <p role="status"><%= import_status(@assessment_request, verified: @assessment.present?) %><% if @assessment_request.failure %> · <%= @assessment_request.failure %><% end %></p>
  <% end %>
  <% if @assessment_request&.active? && !CatalogImport.worker_enabled? %><p>Background evidence checks are paused in this environment.</p><% end %>
  <%= button_to "Check provider evidence", investigate_resolution_surface_path(@selected_scrobble || @observation) %>
  <% if @assessment %>
    <p>Assessment <%= browser_time(@assessment.created_at) %>. Applying a candidate requires your decision.</p>
    <%= render "evidence", assessment: @assessment %>
  <% end %>
  <% if @candidates.empty? %>
    <p>No candidates available. Check provider evidence for this observation.</p>
  <% else %>
    <% @candidates.sort_by { |candidate| Array(@assessment.evidence["slots"]).any? { |slot| slot["recording_mbid"] == candidate["id"] } ? 0 : 1 }.each do |candidate| %>
      <%= render "candidate", candidate: candidate %>
    <% end %>
  <% end %>
  <details>
    <summary>Recent assessments</summary>
    <% if @assessment_history.any? %>
      <ul class="catalog-list">
        <% @assessment_history.each do |assessment| %>
          <li><%= link_to "Assessment #{assessment.id}", resolution_surface_path(@observation, assessment: assessment.id, play: @selected_scrobble&.id) %> · <%= browser_time(assessment.created_at) %></li>
        <% end %>
      </ul>
      <% if @next_assessment %><p><%= link_to "Earlier assessments", resolution_surface_path(@observation, assessment_before: @next_assessment, play: @selected_scrobble&.id) %></p><% end %>
    <% else %><p>No assessments on this page.</p><% end %>
  </details>
</section>

<section class="card library-card">
  <h2>Matching observations</h2>
  <table class="catalog-table">
    <thead><tr><th scope="col">Played at</th><th scope="col">Effective recording</th><th scope="col">Scope</th></tr></thead>
    <tbody>
      <% @scrobbles.each do |play| %>
        <% head = @exception_heads[play.id] %>
        <tr><td><%= browser_time(play.played_at) %></td>
          <td><%= @recording_titles[play.effective_recording_id] || "Unresolved" %></td>
          <td><%= link_to(head && head.mode != "inherit" ? "Review exception" : "Review this observation",
            resolution_surface_path(@observation, play: play.id, assessment: @assessment&.id)) %></td></tr>
      <% end %>
    </tbody>
  </table>
  <% if @next_scrobble %><p><%= link_to "Older observations", resolution_surface_path(@observation, before: @next_scrobble) %></p><% end %>
</section>

<section class="card library-card">
  <h2>Decision history</h2>
  <% if @history.any? %>
    <ul class="catalog-list">
      <% @history.each do |decision| %>
        <li><%= browser_time(decision.created_at) %> · <%= decision.user_id ? "Your decision" : "Automatic decision" %>
          · <%= decision.scrobble_id ? "One observation" : "Surface" %> · <%= decision.mode.humanize %>
          <% if decision.recording_id %> · <%= catalog_link(Recording.find(decision.recording_id)) %><% end %>
          <% if decision.assessment_id %> · <%= link_to "Assessment", resolution_surface_path(@observation, assessment: decision.assessment_id, play: decision.scrobble_id) %><% end %>
          <br><%= decision.reason %></li>
      <% end %>
    </ul>
    <% if @next_history %><p><%= link_to "Earlier decisions", resolution_surface_path(@observation, history_before: @next_history, play: @selected_scrobble&.id) %></p><% end %>
  <% else %><p>No decisions yet.</p><% end %>
</section>
