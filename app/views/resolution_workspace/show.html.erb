<div class="card library-card resolution-review">
<section class="intro review-heading">
  <% review_state = if @current_recording
      Clients::Musicbrainz::MBID.match?(@current_recording.mbid.to_s) ? "Resolved" : "Partially resolved"
    else
      @candidates.many? ? "Ambiguous" : "Unresolved"
    end %>
  <strong class="review-state"><%= review_state %></strong>
  <p><%= link_to "Recording resolution", resolution_surfaces_path %></p>
  <h1><%= observed_text(@observation.payload["artist_name"], "Artist") %> — <%= observed_text(@observation.payload["track_name"], "Track") %></h1>
  <p><%= observed_text(@observation.payload["artist_name"], "Artist") %> · <%= observed_text(@observation.payload["album_name"], "Album") %></p>
  <p><%= pluralize(@observations_count, "observation") %> with these exact Last.fm strings · Observation <%= (@selected_scrobble || @observation).id %>.</p>
</section>
<nav class="review-sections" aria-label="Review sections">
  <a href="#review-candidates">Candidates</a>
  <a href="#review-evidence">Evidence</a>
  <a href="#review-observations">Observations (<%= @observations_count %>)</a>
  <a href="#review-history">History</a>
</nav>
<div class="review-grid">
<aside class="review-sidebar" aria-label="Resolution and investigation summary">
<section class="review-sidebar-card" aria-labelledby="recording-status">
  <h2 id="recording-status">Resolution</h2>
  <% if @current_recording && Clients::Musicbrainz::MBID.match?(@current_recording.mbid.to_s) %>
    <p><strong>Resolved</strong> · <%= catalog_link(@current_recording) %></p>
    <p class="muted"><%= @current_decision&.scrobble_id ? "Direct assignment for this observation" :
      (@current_decision&.user_id ? "Inherited from your exact-surface assignment" : "Derived from a recorded assessment") %>
      <% if @current_decision %> · <%= @current_decision.reason %><% end %></p>
  <% elsif @current_recording %>
    <p><strong>Partially resolved</strong> · A local recording is assigned. Its provider identity is unverified.</p>
  <% else %>
    <p><strong><%= @candidates.many? ? "Ambiguous" : "Unresolved" %></strong>
      <% if @current_decision&.mode == "unresolved" %> · Explicitly left unresolved<% end %></p>
  <% end %>
  <h3>Decision scope</h3>
  <% if @selected_scrobble %>
    <p>Reviewing the observation at <%= browser_time(@selected_scrobble.played_at) %>.
      <%= link_to "Review the exact surface", resolution_surface_path(@observation) %></p>
  <% else %>
    <p>Exact matching group · <%= pluralize(@affected_count, "affected observation") %>.</p>
    <p><%= link_to "Review only this observation", resolution_surface_path(@observation, play: @observation.id) %></p>
  <% end %>
</section>
  <section class="review-sidebar-card">
    <h2>Summary</h2>
    <dl>
      <div><dt>Candidates</dt><dd><%= @candidates.size %></dd></div>
      <% if @ranking.any? %><div><dt>Best score</dt><dd><%= @ranking.first["score"] %></dd></div><% end %>
      <% if @assessment_request %><div><dt>Provider calls</dt><dd><%= @assessment_request.request_count %></dd></div><% end %>
    </dl>
  </section>
</aside>
<section class="review-candidates" id="review-candidates">
  <h2>Candidate recordings</h2>
  <% if @assessment_request&.active? %>
    <p role="status"><%= @assessment_request.state == "refreshing" ? "Investigating" : "Investigation pending" %>.
      <%= link_to "Refresh results", resolution_surface_path(@observation, play: @selected_scrobble&.id) %></p>
  <% elsif @assessment_request&.failure == "Investigation expired before completion." %>
    <p role="status">Investigation expired. You can request another check.</p>
  <% elsif @assessment_request&.state == "failed" || @assessment&.evidence&.fetch("partial", false) %>
    <p role="status">Provider evidence unavailable or incomplete. Any retained candidates are shown below.</p>
  <% elsif @assessment_request&.state == "incomplete" %>
    <p role="status">Investigation incomplete. <%= @assessment_request.failure %></p>
  <% elsif @assessment %>
    <p>Investigation completed <%= browser_time(@assessment.created_at) %>.</p>
  <% else %>
    <p>This observation has not been investigated.<%= " Background investigation is paused." unless RecordingResolution::Investigation.enabled? %></p>
  <% end %>
  <% if @assessment && !@assessment_matches_claims %><p>This historical assessment used different source ID claims.</p><% end %>
  <% if @candidates.any? %>
    <p>Scores rank evidence for review. The scrobble supplies no measured duration for comparison.</p>
    <% @candidates.first(3).each_with_index do |candidate, index| %>
      <%= render "candidate", candidate:, rank: @ranking[index], expanded: index.zero?, recommended: index.zero? && RecordingResolution::Ranking.recommended?(@ranking) %>
    <% end %>
    <% if @candidates.size > 3 %>
      <details><summary>Additional candidates</summary>
        <% @candidates.drop(3).each_with_index do |candidate, index| %>
          <%= render "candidate", candidate:, rank: @ranking[index + 3], expanded: false, recommended: false %>
        <% end %>
      </details>
    <% end %>
  <% elsif @assessment %>
    <p>No credible candidates in the retained evidence.</p>
  <% end %>
  <% if @assessment %>
    <details><summary>Assessment evidence and provenance</summary><%= render "evidence", assessment: @assessment %></details>
  <% end %>
  <% if @may_manage_observation && CatalogImport.worker_enabled? && !@assessment_request&.active? %>
    <details>
      <summary>Retry or look up a recording identifier</summary>
      <%= button_to "Refresh candidate evidence", investigate_resolution_surface_path(@selected_scrobble || @observation, play: @selected_scrobble&.id) %>
      <%= form_with url: investigate_resolution_surface_path(@selected_scrobble || @observation, play: @selected_scrobble&.id) do |form| %>
        <%= form.label :manual_mbid, "MusicBrainz recording identifier" %>
        <%= form.text_field :manual_mbid, maxlength: 36, required: true %>
        <%= form.submit "Look up recording", class: "catalog-submit" %>
      <% end %>
    </details>
  <% end %>
  <details>
    <summary>Recent assessments</summary>
    <% if @assessment_history.any? %>
      <ul class="catalog-list">
        <% @assessment_history.each do |assessment| %>
          <li><%= link_to "Assessment #{assessment.id}", resolution_surface_path(@observation, assessment: assessment.id, play: @selected_scrobble&.id) %> · <%= browser_time(assessment.created_at) %></li>
        <% end %>
      </ul>
      <% if @next_assessment %><p><%= link_to "Earlier assessments", resolution_surface_path(@observation, assessment_before: @next_assessment, play: @selected_scrobble&.id) %></p><% end %>
    <% else %><p>No assessments on this page.</p><% end %>
  </details>
</section>

</div>
<section class="review-secondary" id="review-evidence">
  <h2>Observation details</h2>
  <%= render "decision_controls" if @may_manage_observation %>
  <details>
    <summary>Original Last.fm claims</summary>
    <% claims = (@selected_scrobble || @observation).payload.slice(*RecordingResolution::PilotRunner::CLAIM_FIELDS) %>
    <% if claims.values.any?(&:present?) %>
      <ul class="catalog-list"><% claims.each do |field, value| %><% if value.present? %><li><%= field.humanize %> <code><%= value %></code></li><% end %><% end %></ul>
    <% else %><p>No MusicBrainz IDs were supplied.</p><% end %>
  </details>
</section>

<section class="review-secondary" id="review-observations">
  <details><summary>Matching observations</summary>
  <%= dense_table("Matching observations") do %>
    <thead><tr><th scope="col">Played at</th><th scope="col">Effective recording</th><th scope="col">Scope</th></tr></thead>
    <tbody>
      <% @scrobbles.each do |play| %>
        <% head = @exception_heads[play.id] %>
        <tr>
          <th scope="row"><%= entity_link browser_time(play.played_at), resolution_surface_path(@observation, play: play.id, assessment: @assessment&.id) %></th>
          <td><%= @recordings[play.effective_recording_id] ? catalog_link(@recordings.fetch(play.effective_recording_id)) : "Unresolved" %></td>
          <td class="compact-meta"><%= head && head.mode != "inherit" ? "One observation" : "Inherited" %></td>
        </tr>
      <% end %>
    </tbody>
  <% end %>
  <% if @next_scrobble %><p><%= link_to "Older observations", resolution_surface_path(@observation, before: @next_scrobble) %></p><% end %>
</details>
</section>

<section class="review-secondary" id="review-history">
  <details><summary>Decision history</summary>
  <% if @history.any? %>
    <ul class="catalog-list">
      <% @history.each do |decision| %>
        <li><%= browser_time(decision.created_at) %> · <%= decision.user_id ? "Your decision" : "Automatic decision" %>
          · <%= decision.scrobble_id ? "One observation" : "Surface" %> · <%= decision.mode.humanize %>
          <% if decision.recording_id %> · <%= catalog_link(@recordings.fetch(decision.recording_id)) %><% end %>
          <% if decision.assessment_id %> · <%= link_to "Assessment", resolution_surface_path(@observation, assessment: decision.assessment_id, play: decision.scrobble_id) %><% end %>
          <br><%= decision.reason %><% if decision.evidence["comment"].present? %> · <%= decision.evidence["comment"] %><% end %></li>
      <% end %>
    </ul>
    <% if @next_history %><p><%= link_to "Earlier decisions", resolution_surface_path(@observation, history_before: @next_history, play: @selected_scrobble&.id) %></p><% end %>
  <% else %><p>No decisions yet.</p><% end %>
</details>
</section>
</div>
