<% evidence = assessment.evidence %>
<% discogs = evidence.fetch("discogs", {}) %>
<% if evidence.dig("search", "count") %><p>MusicBrainz returned <%= pluralize(evidence.dig("search", "returned") || Array(evidence["candidates"]).size, "candidate") %> of <%= evidence.dig("search", "count") %>.</p><% end %>
<% outage = evidence.dig("reason_details", "provider_temporarily_unavailable") %>
<% if outage&.fetch("provider", nil) == "discogs" %>
  <p>Discogs could not complete its check. MusicBrainz candidates remain available for review, and release verification may still be pending.</p>
<% end %>
<% if evidence["reasons"].present? %>
  <details open>
    <summary>Uncertainty in this assessment</summary>
    <ul class="catalog-list">
      <% labels = { "unverified_edition_slot" => "No verified release track slot", "competing_recordings" => "Competing recordings",
        "missing_source_mbid" => "Missing source recording ID", "unverified_recording" => "Source recording ID unverified",
        "incomplete_discogs_evidence" => "Discogs investigation incomplete", "discogs_disagreement" => "Discogs editions disagree",
        "provider_temporarily_unavailable" => "Provider temporarily unavailable" } %>
      <% evidence["reasons"].each do |reason| %>
        <% details = evidence.fetch("reason_details", {}).fetch(reason, {}) %>
        <li><%= labels.fetch(reason, reason.humanize) %>
          <% if details["message"] %> · <%= details["message"] %><% end %>
          <% if details["causes"] %> · <%= details["causes"].map(&:humanize).join(", ") %><% end %>
          <% if details["candidate_mbids"] %> · <%= pluralize(details["candidate_mbids"].size, "alternative") %><% end %>
        </li>
      <% end %>
    </ul>
  </details>
<% end %>
<% if discogs["status"] && discogs["status"] != "unavailable" %>
  <p>Historical Discogs provenance retained with the original assessment.</p>
<% end %>
