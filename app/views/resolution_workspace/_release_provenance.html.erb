<% provenance.established.each do |tracklist| %>
  <% fields = tracklist.assessment_fields %>
  <% edition = fields.fetch("edition") %>
  <% source = Array(@assessment.evidence["construction_editions"]).find { |item| item["id"] == edition["id"] } %>
  <section class="resolution-context" aria-label="Established canonical release">
    <h2 class="section-heading">Established canonical release</h2>
    <h3 class="resolution-release-title"><%= catalog_link(tracklist.release) %></h3>
    <p class="compact-meta">
      <%= [resolution_release_date(edition["date"]), edition["country"], Array(source&.fetch("media", nil)).pluck("format").compact.uniq.join(" / ").presence, pluralize(fields["slots"].size, "track")].compact.join(" · ") %>
      · <%= link_to "Selected MusicBrainz edition", "https://musicbrainz.org/release/#{edition.fetch('id')}" %>
    </p>
    <%= render "ordered_tracks", tracks: fields.fetch("slots"), mbid:, recording_ids: %>
    <p class="muted">The edition played is unverified.</p>
  </section>
<% end %>
<% if provenance.editions.any? %>
  <% navigation = request.query_parameters.slice("assessment", "play", "edition").merge(candidate: mbid) %>
  <% selected_recording = params[:source_recording] if provenance.appearances.any? { |appearance| appearance.track[:source_recording_mbid] == params[:source_recording] } %>
  <%= tag.details open: selected_recording.present? || provenance.editions.any? { |edition| edition.data["id"] == params[:source_edition] }, class: "release-provenance", id: "release-provenance" do %>
    <summary>Alternative editions and track provenance</summary>
    <p class="muted"><%= pluralize(provenance.editions.size, "checked edition") %> · The edition played is unverified.</p>
    <ul>
      <% provenance.editions.each do |edition| %>
        <% source = edition.data %>
        <li><%= resolution_source_edition(source) %> ·
          <%= link_to "Inspect tracklist", resolution_surface_path(@observation, navigation.merge(source_edition: source["id"], anchor: "release-provenance")) %>
          <% if params[:source_edition] == source["id"] %>
            <% RecordingResolution::ReviewRelease.project(source).fetch("media").each do |medium| %>
              <p class="compact-meta">Medium <%= medium["position"] %> · <%= medium["format"] %></p>
              <%= render "ordered_tracks", tracks: medium.fetch("tracks"), mbid:, recording_ids: %>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
    <% provenance.programs.uniq { |program| program.tracks.pluck(:source_recording_mbid) }.each do |program| %>
      <p><strong>Distinct program for separate review</strong> · <%= resolution_source_edition(program.edition) %>
        · Medium <%= program.medium["position"] %> · <%= program.medium["format"] %> · <%= pluralize(program.tracks.size, "track") %>.
        <%= link_to "Review complete source edition", resolution_surface_path(@observation, navigation.merge(source_edition: program.edition.fetch("id"), anchor: "release-provenance")) %>.</p>
    <% end %>
    <ul>
    <% provenance.appearances.group_by { |appearance| appearance.track[:source_recording_mbid] }.each do |source_id, appearances| %>
      <% track = appearances.first.track %>
      <li>
        <%= link_to track[:title], resolution_surface_path(@observation, navigation.merge(source_recording: source_id, anchor: "release-provenance")) %>
        <%= " · Recording identity needs review" if appearances.all? { |appearance| appearance.comparison == :uncertain } %>
      <% if selected_recording == source_id %>
      <% history = @assessment.evidence.dig("additional_recording_publications", source_id) ||
          @assessment.evidence.dig("recording_publications", source_id) %>
        <p><%= link_to "MusicBrainz recording", "https://musicbrainz.org/recording/#{source_id}" %>
          <%= " · #{track.dig(:recording, 'disambiguation')}" if track.dig(:recording, "disambiguation").present? %></p>
        <ul>
          <% appearances.each do |appearance| %>
            <li><%= resolution_source_edition(appearance.edition) %>
              · Medium <%= appearance.medium["position"] %> (<%= appearance.medium["format"].presence || "Format unavailable" %>)
              · Track <%= appearance.track[:position] %><%= " · Identity unverified" if appearance.comparison == :uncertain %></li>
          <% end %>
        </ul>
        <% if (earliest = history&.dig("earliest_publication")) %>
          <p>Earliest checked appearance · <%= resolution_release_date(earliest["date"]) %> ·
            <%= link_to earliest["title"], "https://musicbrainz.org/release/#{earliest['id']}" %>. Original publication may still be uncertain.</p>
        <% else %>
          <p>Original publication is unverified. Check the recording’s release history and relationships.</p>
        <% end %>
        <% Array(history&.dig("distinct_original_contexts")).each do |source| %>
          <p>Separate original context for catalog review · <%= resolution_source_edition(source) %></p>
        <% end %>
        <% if @may_manage_observation && @assessment_matches_claims && !@assessment_request&.active? %>
          <%= button_to "Investigate track provenance", investigate_resolution_surface_path(@observation),
            params: { provenance_mbid: source_id, assessment_id: @assessment.id, candidate: mbid, play: params[:play].presence } %>
        <% end %>
      <% end %>
      </li>
    <% end %>
    </ul>
  <% end %>
<% end %>
