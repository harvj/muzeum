<section class="intro"><h1>Recording resolution</h1></section>
<section class="card library-card">
  <%= form_with url: resolution_surfaces_path, method: :get, class: "catalog-filter" do |form| %>
    <div><%= form.label :filter, "Show surfaces" %>
      <%= form.select :filter, [["All surfaces", ""]] + RecordingResolution::Workspace::FILTERS.map { |filter| [filter.humanize, filter] }, selected: @filter %></div>
    <%= form.submit "Filter", class: "catalog-submit" %>
  <% end %>
  <% if @rows.any? %>
    <table class="catalog-table">
      <thead><tr><th scope="col">Observed track</th><th scope="col">Artist and album</th><th scope="col">Observations</th></tr></thead>
      <tbody>
        <% @rows.each do |id, artist, album, track, count| %>
          <tr><td><%= link_to(observed_text(track, "Track"), resolution_surface_path(id)) %></td>
            <td><%= observed_text(artist, "Artist") %><br><span class="muted"><%= observed_text(album, "Album") %></span></td><td><%= count %></td></tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No surfaces match this view. Imported Last.fm observations will appear here.</p>
  <% end %>
  <% if @next_page %><p><%= link_to "Next page", resolution_surfaces_path(before: @next_page, filter: @filter) %></p><% end %>
</section>
