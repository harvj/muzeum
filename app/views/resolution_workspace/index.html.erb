<section class="intro"><h1>Recording resolution</h1>
  <p><%= link_to "Prioritize unresolved recordings", resolution_surfaces_path(filter: "unresolved") %></p>
</section>
<section class="card library-card">
  <%= form_with url: resolution_surfaces_path, method: :get, class: "catalog-filter" do |form| %>
    <div><%= form.label :filter, "Show surfaces" %>
      <%= form.select :filter, [["All surfaces", ""]] + RecordingResolution::Workspace::FILTERS.map { |filter| [filter.humanize, filter] }, selected: @filter %></div>
    <%= form.submit "Filter", class: "catalog-submit" %>
  <% end %>
  <% if @rows.any? %>
    <%= dense_table("Observed recording surfaces") do %>
      <thead><tr><th scope="col">Observed track</th><th scope="col">Artist and album</th><th scope="col" class="table-number"><%= @filter == "unresolved" ? "Unresolved observations" : "Observations" %></th><% if @filter == "unresolved" %><th scope="col">Next step</th><% end %></tr></thead>
      <tbody>
        <% @rows.each do |id, artist, album, track, count, review| %>
          <tr><th scope="row"><%= entity_link(observed_text(track, "Track"), resolution_surface_path(id)) %></th>
            <td><%= observed_text(artist, "Artist") %><br><span class="muted"><%= observed_text(album, "Album") %></span></td><td class="table-number"><%= number_with_delimiter(count) %></td>
            <% if @filter == "unresolved" %>
              <% status, action = review %>
              <td><span class="muted"><%= status %></span><br><%= link_to action, resolution_surface_path(id), aria: { label: "#{action} · #{observed_text(track, 'Track')}" } %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    <% end %>
  <% else %>
    <p>No surfaces match this view. Imported Last.fm observations will appear here.</p>
  <% end %>
  <% if @next_page %><p><%= link_to "Next page", resolution_surfaces_path(before: @next_page, before_count: @next_count, filter: @filter) %></p><% end %>
</section>
