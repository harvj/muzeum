<li>
  <% current = candidate == selected %>
  <%= link_to resolution_surface_path(@observation, **navigation.merge(candidate: candidate.fetch("id"), anchor: "review-candidates")),
      class: "resolution-choice", aria: { current: ("true" if current) } do %>
    <span>
      <strong><%= candidate.fetch("title") %></strong>
      <span class="muted"><%= resolution_candidate_credit(candidate) %><% if candidate["length"] %> · <%= recording_duration(candidate["length"]) %><% end %></span>
    </span>
    <span class="muted"><%= contexts.map { |item| item.construction.base.data["title"] }.uniq.to_sentence.presence || "Original release pending" %></span>
    <% if current %><span class="resolution-selected">Selected</span><% end %>
  <% end %>
</li>
