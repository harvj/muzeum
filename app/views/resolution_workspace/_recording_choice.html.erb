<li class="resolution-option">
  <% current = candidate == selected %>
  <% mbid = candidate.fetch("id") %>
  <%= link_to resolution_surface_path(@observation, **navigation.merge(candidate: mbid, anchor: "review-candidates")),
      class: "resolution-choice", aria: { current: ("true" if current) } do %>
    <span>
      <strong><%= candidate.fetch("title") %></strong>
      <span class="muted"><%= resolution_candidate_credit(candidate) %><% if candidate["length"] %> · <%= recording_duration(candidate["length"]) %><% end %><% if candidate["disambiguation"].present? %> · <%= candidate["disambiguation"] %><% end %></span>
    </span>
    <% if association %><span class="resolution-association muted"><%= association %></span><% end %>
    <% if current %><span class="resolution-selected"><span aria-hidden="true">✓</span> Selected</span><% end %>
  <% end %>
  <% if show_mbid && Clients::Musicbrainz::MBID.match?(mbid) %>
    <%= link_to mbid.first(8), "https://musicbrainz.org/recording/#{mbid}", class: "resolution-recording-mbid",
      aria: { label: "MusicBrainz recording #{mbid}" } %>
  <% end %>
  <% if local_assigns[:badge] %><div class="resolution-option-status"><%= badge %></div><% end %>
</li>
