  <% provider_incomplete = @assessment&.evidence&.fetch("partial", false) %>
  <% request_failed = @assessment_request&.state == "failed" %>
  <% throttled = request_failed && @assessment_request.failure == "musicbrainz throttled (503)" %>
  <% expired = @assessment_request&.expired_investigation? || @assessment_request&.failure == "Investigation expired before completion." %>
  <% queue_state = @assessment_request.investigation_queue_state if @assessment_request && !expired && params[:assessment].blank? %>
  <% can_retry = @may_manage_observation && CatalogImport.worker_enabled? %>
  <% if expired %>
    <p role="status" class="investigation-badge"><%= can_retry ? "Failed — Retry" : "Needs attention" %></p>
    <p class="muted">The investigation expired.</p>
    <%= button_to "Retry search", investigate_resolution_surface_path(@observation) if can_retry %>
  <% elsif queue_state.in?([ :queued, :investigating, :retrying ]) %>
    <div class="investigation-progress" role="status" aria-label="Investigation progress">
      <ul>
        <% { queued: "Queued", investigating: "Investigating", retrying: "Waiting to retry",
          complete: "Investigation complete", review: "Needs review" }.each do |state, label| %>
          <%= tag.li label, aria: { current: ("true" if state == queue_state) } %>
        <% end %>
      </ul>
      <% if queue_state == :retrying %>
        <p class="muted">Next attempt <%= browser_time(@assessment_request.due_at) %>.</p>
      <% end %>
    </div>
  <% elsif @assessment_request&.active? && params[:assessment].blank? %>
    <p role="status" class="investigation-badge">Needs attention</p>
    <p class="muted"><%= queue_state == :unavailable ? "The investigation queue could not be checked." : "No investigation attempt is scheduled." %></p>
    <%= button_to "Retry search", investigate_resolution_surface_path(@observation) if can_retry && queue_state != :unavailable %>
  <% elsif request_failed && @assessment_request.failure == CatalogImport::INVESTIGATION_WORKER_FAILURE %>
    <p role="status" class="investigation-badge">Failed — Needs Codex</p>
    <p class="muted">The investigation worker failed unexpectedly.</p>
  <% elsif request_failed || provider_incomplete %>
    <div class="investigation-outcome">
      <div role="status">
        <p class="investigation-badge"><%= request_failed && can_retry ? "Failed — Retry" : "Needs attention" %></p>
        <p class="muted"><%= throttled ? "MusicBrainz search unavailable" : "Provider evidence unavailable or incomplete" %></p>
        <p><% if throttled %>
          <%= pluralize(@assessment_request.attempts, "recording-search attempt") %> failed (HTTP 503).
        <% end %>
        <% if @candidates.any? %>Retained candidates are shown below.<% else %>No verified candidates are available yet.<% end %></p>
        <% if request_failed && can_retry %><p>Retrying the search preserves the original observation and its evidence.</p><% end %>
      </div>
      <% if request_failed && can_retry %>
        <%= button_to "Retry search", investigate_resolution_surface_path(@observation) %>
      <% end %>
    </div>
  <% elsif @assessment_request&.state == "incomplete" %>
    <p role="status" class="investigation-badge">Needs review</p>
    <p class="muted"><%= @assessment_request.failure %></p>
  <% elsif @assessment %>
    <% disputed = contexts.values.any? { |proposals| proposals.group_by { |proposal| proposal.construction.base.data.dig("release-group", "id") }.values.any?(&:many?) } %>
    <p role="status" class="investigation-badge"><%= @candidates.one? && !disputed ? "Investigation complete" : "Needs review" %></p>
    <% unless compact %><p class="muted"><%= browser_time(@assessment.created_at) %></p><% end %>
  <% else %>
    <p>This observation has not been investigated.<%= " Background investigation is paused." unless RecordingResolution::Investigation.enabled? %></p>
  <% end %>
  <% if @assessment && !@assessment_matches_claims %><p>This historical assessment used different source ID claims.</p><% end %>
