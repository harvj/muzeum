<% mbid = selected.fetch("id") %>
<% catalog_recording = catalog_rows[1][1].first %>
<% catalog_releases = catalog_rows[2][1] %>
<% release_pending = contexts.empty? && catalog_releases.empty? %>
<% groups = contexts.group_by { |item| item.construction.base.data.dig("release-group", "id") }.values.sort_by do |choices|
  release = choices.first.construction.base.data
  [release.dig("release-group", "primary-type") == "Album" ? 0 : 1, release.fetch("date"), release.fetch("id")]
end %>
<% plan = CanonicalCatalog::ResolutionPlan.new(@assessment, mbid, @affected_count) %>
<% proposals = plan.proposals %>
<% earliest = @assessment.evidence.dig("recording_publications", mbid, "earliest_publication", "date") %>
<section class="resolution-context" aria-label="Original release">
  <h2>Original release</h2>
  <% if groups.any? %>
    <% groups.each do |choices| %>
      <% base = choices.first.construction.base %>
      <% release = base.data %>
      <div>
        <strong><%= release["title"] %></strong>
        <p><%= resolution_release_date(release.fetch("date")) %> · <%= release.dig("release-group", "primary-type") || "Release" %> · <%= pluralize(base.slots.size, "track") %></p>
        <p class="muted"><%= choices.many? ? "Multiple original editions verified" : "Original release verified" %></p>
        <% if choices.one? %>
          <details class="review-original-tracklist"><summary>View original tracklist</summary>
            <%= render "review_tracklist", release: RecordingResolution::ReviewRelease.project(release), release_id: release["id"], mbid: %>
          </details>
          <% choices.first.construction.additional_slots.each do |slot| %>
            <p class="muted">Selected recording appears on a later edition · <%= resolution_release_date(slot.fetch(:appearance_date)) %></p>
          <% end %>
        <% end %>
      </div>
    <% end %>
    <% if earliest && groups.none? { |choices| choices.any? { |item| item.construction.base.data["date"] == earliest && item.construction.base.data.dig("release-group", "primary-type") == "Album" } } %>
      <p class="muted">Earliest verified recording publication · <%= resolution_release_date(earliest) %></p>
    <% end %>
  <% elsif catalog_releases.any? %>
    <p class="muted">Verified catalog appearances are listed above. Original release evidence is unavailable here.</p>
  <% else %>
    <p>Original release verification is pending.</p>
  <% end %>
</section>
<% if @may_manage_observation && @assessment_matches_claims %>
  <%= form_with url: decide_resolution_surface_path(@observation), class: "resolution-confirmation" do |form| %>
    <%= form.hidden_field :recording_mbid, value: mbid %>
    <%= form.hidden_field :assessment_id, value: @assessment.id %>
    <%= form.hidden_field :resolution_plan, value: plan.fingerprint %>
    <%= form.hidden_field :scope, value: "surface" %>
    <%= form.hidden_field :mode, value: "resolved" %>
    <%= form.hidden_field :head, value: @surface_head&.id %>
    <% if @listener_ranking_token %><%= form.hidden_field :listener_ranking_token, value: @listener_ranking_token %><% end %>
    <% proposals.each do |proposal| %>
      <%= hidden_field_tag "construction_heads[#{proposal.construction.base.data['id']}]", CanonicalCatalog::ReviewedConstruction.head(proposal.existing), id: nil %>
    <% end %>
    <% if proposals.many? %>
      <label for="construct_release">Release to confirm</label>
      <%= select_tag :construct_release, options_for_select(resolution_edition_options(proposals)),
        include_blank: "Choose a verified sequence", required: true %>
    <% elsif proposals.one? %>
      <%= hidden_field_tag :construct_release, proposals.first.construction.base.data["id"] %>
    <% end %>
    <section aria-label="Resolution preview">
      <h2>Resolution preview</h2>
      <ul class="catalog-list">
        <li><strong><%= catalog_recording ? "Reuse" : "Create" %></strong> · <%= selected.fetch("title") %></li>
        <% if proposals.empty? %>
          <li><strong>No change</strong> · 0 new releases<%= " · #{catalog_releases.map(&:title).to_sentence}" if catalog_releases.any? %></li>
        <% else %>
          <% proposals.each do |proposal| %>
            <% base = proposal.construction.base %>
            <li><strong><%= proposal.existing ? "Reuse" : "Create" %></strong> · <%= base.data.fetch("title") %> ·
              <%= proposal.existing ? "0" : "1" %> new <%= proposal.existing ? "releases" : "release" %> ·
              <%= pluralize(base.slots.size, "base track") %> to construct<% if proposal.construction.additional_slots.any? %> ·
                <%= pluralize(proposal.construction.additional_slots.size, "additional appearance") %><% end %>
              <details><summary>Artists and track memberships</summary>
                <ul>
                  <% plan.artists(proposal).each do |artist, existing| %>
                    <li><strong><%= existing ? "Reuse" : "Create" %></strong> · <%= artist.fetch("name") %></li>
                  <% end %>
                  <% (base.slots + proposal.construction.additional_slots).each do |slot| %>
                    <li><strong>Create</strong> · <%= slot.fetch(:medium) %>.<%= slot.fetch(:position) %> · <%= slot.fetch(:title) %><%= " · #{slot[:appearance_date]}" if slot[:appearance_date] %></li>
                  <% end %>
                </ul>
              </details>
            </li>
          <% end %>
        <% end %>
        <li><strong>Assign</strong> · <%= pluralize(@affected_count, "existing observation") %></li>
      </ul>
      <p class="muted">Recording metadata and credits may be enriched after confirmation.</p>
    </section>
    <p class="muted">
      <% if release_pending %>Save the recording assignment while release verification continues.
      <% elsif proposals.any?(&:existing) %>Confirm the recording and update <%= proposals.first.construction.base.data["title"] %>. Review the changes in Evidence.
      <% elsif proposals.any? %>Confirm the recording and add <%= proposals.first.construction.base.data["title"] %> to your catalog.
      <% else %>Use this recording for the matching observations.
      <% end %>
      Future exact matches inherit this decision.
      <% if @override_count.positive? %><%= pluralize(@override_count, "individual override") %> preserved.<% end %>
    </p>
    <div class="resolution-actions">
      <%= form.button class: "resolution-primary" do %>
        <span aria-hidden="true">✓</span>
        <%= if release_pending
          "Resolve recording only"
        elsif @affected_count.zero?
          "Resolve future matches"
        elsif @override_count.positive?
          "Resolve #{@affected_count} matching"
        elsif @affected_count == 1
          "Resolve this observation"
        else
          "Resolve all #{@affected_count}"
        end %>
      <% end %>
      <%= link_to "Review evidence", resolution_surface_path(@observation, **navigation.merge(section: "evidence")) %>
      <%= form.button "Defer", name: "feedback", value: "deferred", formnovalidate: true, formaction: defer_resolution_surface_path(@observation) %>
    </div>
  <% end %>
<% end %>
