<% mbid = selected.fetch("id") %>
<% catalog_releases = catalog_rows[2][1] %>
<% release_pending = contexts.empty? && catalog_releases.empty? %>
<% groups = contexts.group_by { |item| item.construction.base.data.dig("release-group", "id") }.values.sort_by do |choices|
  release = choices.first.construction.base.data
  [release.dig("release-group", "primary-type") == "Album" ? 0 : 1, release.fetch("date"), release.fetch("id")]
end %>
<% plan = CanonicalCatalog::ResolutionPlan.new(@assessment, mbid, @affected_count) %>
<% catalog_recording = plan.recording || catalog_rows[1][1].first %>
<% proposals = plan.proposals %>
<% provenance = RecordingResolution::ReleaseProvenance.new(@assessment.evidence, contexts:, releases: catalog_releases) %>
<% established = provenance.established.any? %>
<% requested_edition = params[:edition].presence %>
<% selected_edition = requested_edition if params[:review_edition].blank? && proposals.any? { |proposal| plan.edition_id(proposal) == requested_edition } %>
<% invalid_edition = requested_edition.present? && selected_edition.nil? %>
<% can_confirm = @may_manage_observation && @assessment_matches_claims %>
<% choosing_release = can_confirm && (proposals.many? || (invalid_edition && proposals.one?)) %>
<% comparison = CanonicalCatalog::ReleaseComparison.new(proposals) if choosing_release %>
<%= tag.div data: ((choosing_release || invalid_edition) ? { controller: "release-proposal", action: "turbo:morph@document->release-proposal#restoreSelection" } : {}) do %>
<% if invalid_edition %>
  <p role="alert" data-release-proposal-target="warning">The selected edition is no longer in this review. Choose a current edition before confirming.</p>
<% end %>
<%= render "release_provenance", provenance:, mbid:, recording_ids: plan.identity.source_ids || [mbid] if established %>
<% if choosing_release %>
  <% if established %>
    <details><summary>Review a correction to the selected base edition</summary>
      <%= render "release_comparison", comparison:, selected_edition: %>
    </details>
  <% else %>
    <%= render "release_comparison", comparison:, selected_edition: %>
  <% end %>
<% end %>
<% earliest = @assessment.evidence.dig("recording_publications", mbid, "earliest_publication", "date") %>
<% unless established %>
<section class="resolution-context" aria-label="Original release">
  <h2 class="section-heading">Original release</h2>
  <% if groups.any? %>
    <% shown_groups = choosing_release ? [proposals] : groups %>
    <% shown_groups.each do |choices| %>
      <% choices.each do |choice| %>
        <% base = choice.construction.base %>
        <% release = base.data %>
        <%= tag.div hidden: choosing_release && selected_edition != release["id"], data: (choosing_release ? { release_proposal_target: "proposal", edition: release["id"] } : {}) do %>
          <h3 class="resolution-release-title"><%= release["title"] %></h3>
          <p><%= resolution_release_date(release.fetch("date")) %><%= " · #{release['country']}" if choices.many? && release["country"].present? %></p>
          <% tracks = base.slots.map do |slot|
            { "title" => slot[:title], "recording_mbid" => slot.dig(:recording, "id"),
              "length" => slot[:duration_ms] || slot.dig(:recording, "length") }
          end %>
          <% shared_count = comparison&.shared&.size.to_i %>
          <%= render "ordered_tracks", tracks: tracks.drop(shared_count), mbid:, start: shared_count + 1 %>
        <% end %>
      <% end %>
    <% end %>
    <% if earliest && groups.none? { |choices| choices.any? { |item| item.construction.base.data["date"] == earliest && item.construction.base.data.dig("release-group", "primary-type") == "Album" } } %>
      <p class="muted">Earliest verified recording publication · <%= resolution_release_date(earliest) %></p>
    <% end %>
  <% elsif catalog_releases.any? %>
    <p class="muted">Verified catalog appearances are listed above. Original release evidence is unavailable here.</p>
  <% else %>
    <p>The available evidence does not verify an original release and its tracklist.
      <% if can_confirm && !invalid_edition %>You can resolve the recording without adding a release.<% end %>
    </p>
  <% end %>
</section>
  <%= render "release_provenance", provenance:, mbid:, recording_ids: plan.identity.source_ids || [mbid] %>
<% end %>
<% if can_confirm && (!invalid_edition || proposals.any?) %>
  <%= form_with url: decide_resolution_surface_path(@observation), class: "resolution-confirmation", id: "recording-resolution-confirmation" do |form| %>
    <%= form.hidden_field :recording_mbid, value: mbid %>
    <%= form.hidden_field :assessment_id, value: @assessment.id %>
    <%= hidden_field_tag :latest_release_review, "1" if proposals.any? && params[:assessment].blank? %>
    <%= form.hidden_field :resolution_plan, value: plan.fingerprint %>
    <%= form.hidden_field :scope, value: "surface" %>
    <%= form.hidden_field :mode, value: "resolved" %>
    <%= form.hidden_field :head, value: @surface_head&.id %>
    <% if @listener_ranking_token %><%= form.hidden_field :listener_ranking_token, value: @listener_ranking_token %><% end %>
    <% proposals.each do |proposal| %>
      <%= hidden_field_tag "construction_heads[#{proposal.construction.base.data['id']}]", CanonicalCatalog::ReviewedConstruction.head(proposal.existing), id: nil %>
    <% end %>
    <% if proposals.one? && !choosing_release %>
      <%= hidden_field_tag :construct_release, proposals.first.construction.base.data["id"] %>
    <% end %>
    <section aria-label="Resolution preview">
      <h2 class="section-heading">Resolution preview</h2>
      <ul class="catalog-list">
        <li><strong>Recording</strong> · <%= selected.fetch("title") %> · <%= resolution_candidate_credit(selected) %><%= " · Reuse existing" if catalog_recording %>
          <% if plan.identity.aliases&.any? %> · <%= pluralize(plan.identity.aliases.size, "equivalent source ID") %> will be linked<% end %>
        </li>
        <% if proposals.empty? %>
          <li><strong>Release</strong> · 0 new releases<%= " · #{catalog_releases.map(&:title).to_sentence}" if catalog_releases.any? %></li>
        <% else %>
          <% proposals.each do |proposal| %>
            <% base = proposal.construction.base %>
            <% additions = proposal.construction.additional_tracks %>
            <% admitted_ids = proposal.construction.additional_slots.map { |slot| slot.dig(:recording, "id") }.to_set %>
            <% artists = plan.artists(proposal) %>
            <% new_recordings, existing_recordings = plan.track_recordings(proposal) %>
            <%= tag.li hidden: choosing_release && selected_edition != base.data["id"], data: (choosing_release ? { release_proposal_target: "proposal", edition: base.data["id"] } : {}) do %>
              <strong>Release</strong> · <%= base.data.fetch("title") %> · <%= pluralize(base.slots.size, "track") %> ·
              <%= proposal.existing ? "Reuse existing release · Rebuild base tracklist" : "1 new release" %>
              <div class="muted"><%= resolution_candidate_credit(base.data) %></div>
              <div class="muted"><%= [("#{pluralize(new_recordings, 'new recording')}" if new_recordings.positive?),
                ("Reuse #{pluralize(existing_recordings.map { |row| row[1] }.uniq.size, 'recording')}" if existing_recordings.any?)].compact.join(" · ") %></div>
              <% if artists.any? %>
                <details><summary><%= pluralize(artists.size, "credited artist") %></summary>
                  <ul>
                    <% artists.each do |artist, existing| %>
                      <li><strong>Artist</strong> · <%= artist.fetch("name") %><%= " · Reuse existing" if existing %></li>
                    <% end %>
                  </ul>
                </details>
              <% end %>
              <% uncertain = proposal.construction.appearances.select { |edition| edition["uncertain_tracks"].present? } %>
              <% if uncertain.any? && (choosing_release || provenance.editions.empty?) %>
                <details>
                  <summary>Edition tracks with unverified recording identity</summary>
                  <ul>
                    <% uncertain.each do |edition| %>
                      <% edition.fetch("uncertain_tracks").each do |track| %>
                        <li><%= track.fetch("title") %> · <%= link_to edition.fetch("title"), "https://musicbrainz.org/release/#{edition.fetch('id')}" %></li>
                      <% end %>
                    <% end %>
                  </ul>
                </details>
              <% end %>
              <% if additions.any? && (choosing_release || provenance.editions.empty? || admitted_ids.any?) %>
                <details>
                  <summary><%= pluralize(choosing_release || provenance.editions.empty? ? additions.size : admitted_ids.size, "additional edition track") %></summary>
                  <ul>
                    <% additions.each do |appearances| %>
                      <% next if !choosing_release && provenance.editions.any? && appearances.none? { |track| admitted_ids.include?(track.fetch("recording_mbid")) } %>
                      <% title = appearances.first.fetch("title") %>
                      <% admission = appearances.any? { |track| admitted_ids.include?(track.fetch("recording_mbid")) } %>
                      <li><%= title %> <span class="muted">· <%= admission ? "Admit selected recording" : "Edition evidence" %></span></li>
                    <% end %>
                  </ul>
                </details>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
        <li><strong>Listening history</strong> · <%= pluralize(@affected_count, "existing observation") %></li>
      </ul>
      <p class="muted">Recording metadata and credits may be enriched after confirmation.</p>
    </section>
    <p class="muted">
      Future exact matches inherit this decision.
      <% if @override_count.positive? %><%= pluralize(@override_count, "individual override") %> preserved.<% end %>
    </p>
    <div class="resolution-actions">
      <%= form.button class: "resolution-primary" do %>
        <span class="resolution-confirmation-mark" aria-hidden="true">✓</span>
        <%= if release_pending
          "Resolve recording only"
        elsif @affected_count.zero?
          "Resolve future matches"
        elsif @override_count.positive?
          "Resolve #{@affected_count} matching"
        elsif @affected_count == 1
          "Resolve this observation"
        else
          "Resolve all #{@affected_count}"
        end %>
      <% end %>
      <%= link_to "Review evidence", resolution_surface_path(@observation, **navigation.merge(section: "evidence")) %>
      <%= form.button "Defer", name: "feedback", value: "deferred", formnovalidate: true, formaction: defer_resolution_surface_path(@observation) %>
    </div>
  <% end %>
<% elsif invalid_edition %>
  <p><%= link_to "Review current proposal", resolution_surface_path(@observation, **navigation) %></p>
<% end %>
<% end %>
