<% mbid = candidate.fetch("id") %>
<% appearance = rank.dig("inputs", "catalog_release_appearance", "provenance") %>
<% edition = @assessment.evidence["edition"] if Array(@assessment.evidence["slots"]).any? { |slot| slot["recording_mbid"] == mbid } %>
<% local_id = candidate.dig("local_release_context", "edition_mbid") %>
<% references = Array(candidate["releases"]) %>
<% references = [ { "id" => local_id }, *references ] if local_id %>
<% shared_isrc = @candidates.any? { |other| other["id"] != mbid && (Array(other["isrcs"]) & Array(candidate["isrcs"])).any? } %>
<% retained_appearance = @review_releases.values.find do |listing|
  listing["state"] == "complete" && Array(listing["media"]).any? do |medium|
    Array(medium["tracks"]).any? { |track| track["recording_mbid"] == mbid }
  end
end %>
<% reference = appearance || edition || references.find { |item| @review_releases[item["id"]]&.fetch("state", nil) == "complete" } || retained_appearance || references.first %>
<% release_id = reference&.fetch("id", nil) %>
<% release = @review_releases[release_id] %>
<% metadata = (reference || {}).merge(release || {}) %>
<% release_date = metadata["date"].presence %>
<% countries = Array(metadata["countries"]).presence || Array(metadata["country"]) %>
<% factors = rank.fetch("inputs").select { |_, item| %w[positive contradictory].include?(item["state"]) } %>
<% positives, conflicts = factors.partition { |_, item| item["state"] == "positive" } %>
<% target = @selected_scrobble || @observation %>
<details class="candidate review-candidate<%= " recommended" if recommended %>" name="resolution-candidate" <%= "open" if expanded %>>
  <summary class="review-candidate-summary">
    <span>
      <% if recommended %><strong class="review-recommendation" aria-label="Muzeum’s recommendation">Recommended</strong><% end %>
      <strong class="review-candidate-title"><%= candidate["title"] %></strong>
      <span class="review-credit"><%= Array(candidate["artist-credit"]).map { |credit| "#{credit["name"]}#{credit["joinphrase"]}" }.join.presence || "Artist credit unavailable" %>
        <% if candidate["disambiguation"].present? %> · <%= candidate["disambiguation"] %><% end %></span>

      <span class="compact-meta"><%= recording_duration(candidate["length"]) if candidate["length"] %><%= " · " if candidate["length"] %>MusicBrainz ID <%= mbid.first(8) %></span>
    </span>
    <span class="review-score">Score <strong><%= rank["score"] %></strong></span>
  </summary>
  <% catalog_rows = @catalog_context.rows(candidate) %>
  <% catalog_recording = catalog_rows[1][1].first %>
  <%= render("catalog_panel", catalog_rows:) unless expanded %>
  <% if @may_manage_observation && @assessment_matches_claims %>
  <% proposals = CanonicalCatalog::ReviewedConstruction.for(@assessment, mbid).group_by { |item| item.construction.base.data.dig("release-group", "id") }.values.first || [] %>
  <% proposals = [] if proposals.any? { |item| !CanonicalCatalog::ReviewedConstruction.needs_review?(item, catalog_recording) } %>
  <%= form_with url: decide_resolution_surface_path(@observation) do |form| %>
    <%= form.hidden_field :recording_mbid, value: mbid, id: nil %>
    <%= form.hidden_field :assessment_id, value: @assessment.id, id: nil %>
    <% if @listener_ranking_token %><%= form.hidden_field :listener_ranking_token, value: @listener_ranking_token, id: nil %><% end %>
    <%= form.hidden_field :scope, value: "surface", id: nil %>
    <%= form.hidden_field :head, value: @surface_head&.id, id: nil %>
    <details><summary>Add an optional comment</summary>
      <%= form.label :comment, "Comment (optional)", for: "comment-#{mbid}" %>
      <%= form.text_field :comment, id: "comment-#{mbid}", maxlength: 500 %>
    </details>
    <p class="muted">Future exact matches inherit this decision. Individual overrides are preserved.</p>
    <% if proposals.empty? && @assessment.evidence["pending_original_group"].present? %>
      <p class="muted">Original release verification is pending. You can refresh the candidate evidence.</p>
    <% end %>
    <% if proposals.any? %>
      <%= form.hidden_field :construction_head, value: CanonicalCatalog::ReviewedConstruction.head(proposals.first.existing), id: nil %>
      <% if proposals.many? %><p>Original editions differ. Choose the complete tracklist to use.</p><% end %>
      <% proposals.each do |proposal| %>
        <% base = proposal.construction.base %>
        <% data = base.data %>
        <p class="compact-meta">
          <strong><%= proposals.one? ? "Proposed original release" : "Original release option" %></strong>
          · <%= data["title"] %> · <%= data["date"] %> · <%= data["country"].presence || "Country unavailable" %>
          · <%= Array(data["media"]).filter_map { |medium| medium["format"].presence }.uniq.join(" / ").presence || "Format unavailable" %>
          · <%= pluralize(base.slots.size, "track") %>
          <% if data["packaging"].present? && data["packaging"] != "None" %> · <%= data["packaging"] %><% end %>
          <% if data["disambiguation"].present? %> · <%= data["disambiguation"] %><% end %>
          · <%= link_to data["id"], "https://musicbrainz.org/release/#{data['id']}", aria: { label: "MusicBrainz release #{data['id']}" } %>
        </p>
        <details class="review-original-tracklist">
          <summary><%= proposal.existing ? "Review release correction" : "Review release construction" %> · Complete tracklist</summary>
          <%= render "review_tracklist", release: RecordingResolution::ReviewRelease.project(data), release_id: data["id"], mbid: %>
          <% if proposal.construction.additional_slots.any? %>
            <p>Additional edition appearances</p>
            <ul><% proposal.construction.additional_slots.each do |slot| %><li><%= slot[:title] %> · <%= slot[:appearance_date] %></li><% end %></ul>
          <% end %>
        </details>
        <%= form.button "#{proposal.existing ? 'Correct' : 'Construct'} release & resolve #{pluralize(@affected_count, 'observation')}#{(" · #{data['country']} / #{base.slots.size} tracks (#{data['id'].first(8)})" if proposals.many?)}",
          name: "construct_release", value: data["id"] %>
      <% end %>
    <% end %>
    <div class="catalog-actions">
      <%= form.button(proposals.any? ? "Resolve recording only" : (@affected_count.positive? ? "Resolve #{pluralize(@affected_count, 'observation')}" : "Resolve future exact matches"), name: "mode", value: "resolved") %>
      <%= form.button "Defer", name: "feedback", value: "deferred", formaction: defer_resolution_surface_path(@observation) %>
      <%= form.button "Reject candidate", name: "feedback", value: "rejected", formaction: defer_resolution_surface_path(@observation) %>
    </div>
  <% end %>
  <% end %>
  <div class="review-candidate-detail">
    <div>
      <p class="compact-meta review-recording-id"><%= rank["provenance"] == "local_catalog" ? "Local catalog" : "MusicBrainz" %> ·
        <%= link_to "Recording #{mbid}", "https://musicbrainz.org/recording/#{mbid}", title: mbid %></p>
      <% if reference %>
        <p class="compact-meta review-edition">Recording appearance · <%= metadata["title"] %><% if metadata["disambiguation"].present? %> · <%= metadata["disambiguation"] %><% end %>
          · <%= release_date || "Release date unavailable" %> ·
          <% if countries.empty? %>Country unavailable<% end %>
          <% countries.each_with_index do |country, index| %><%= ", " if index.positive? %><%= render "shared/geographic_place", country: %><% end %>
        </p>
      <% end %>
      <%= render "review_tracklist", release:, release_id:, mbid: %>
      <% other_contexts = @review_releases.values.select do |listing|
        listing["id"] != release_id && listing["state"] == "complete" && listing["title"].present? &&
          (listing["release_group_mbid"].blank? || listing["release_group_mbid"] != release&.fetch("release_group_mbid", nil)) &&
          Array(listing["media"]).any? { |medium| Array(medium["tracks"]).any? { |track| track["recording_mbid"] == mbid } }
      end.uniq { |listing| listing["release_group_mbid"] || listing["id"] }.first(3) %>
      <% other_contexts.each do |listing| %>
        <details>
          <summary><%= listing["title"] %><%= " · #{listing["date"]}" if listing["date"].present? %></summary>
          <%= render "review_tracklist", release: listing, release_id: listing["id"], mbid: %>
        </details>
      <% end %>
    </div>
    <div class="review-factors">
      <h3>For</h3>
      <ul><% positives.each do |key, item| %><li><%= review_factor_label(key, item) %></li><% end %></ul>
      <h3>Against</h3>
      <% if conflicts.any? %>
        <ul><% conflicts.each do |key, item| %><li><%= review_factor_label(key, item) %></li><% end %></ul>
      <% else %><p>No conflict in the available evidence.</p><% end %>
      <h3>Uncertainty</h3>
      <p>The source observation provides no measured duration for comparison.</p>
      <% if @candidates.many? %>
        <% if shared_isrc %><p>MusicBrainz lists a shared ISRC for at least one alternative.</p><% end %>
        <p>Whether these catalog recording IDs represent the same audio is unknown.</p>
      <% end %>
      <details class="review-score-explanation">
        <summary>Explain score <%= rank["score"] %></summary>
        <ul><% factors.each do |key, item| %><li><%= "%+d" % item["weight"] %> · <%= review_factor_label(key, item) %></li><% end %></ul>
        <p>Scores express relative evidence strength. They are not probabilities or calibrated confidence.</p>
      </details>
    </div>
  </div>
  <% if @may_manage_observation && @assessment_matches_claims %>
  <details>
    <summary>Resolve only this observation</summary>
    <p>Applies only to observation <%= target.id %>.</p>
    <%= form_with url: decide_resolution_surface_path(@observation) do |form| %>
      <%= form.hidden_field :scope, value: "scrobble", id: nil %>
      <%= form.hidden_field :play_id, value: target.id, id: nil %>
      <%= form.hidden_field :head, value: @selected_head&.id, id: nil %>
      <%= form.hidden_field :recording_mbid, value: mbid, id: nil %>
      <%= form.hidden_field :assessment_id, value: @assessment.id, id: nil %>
      <% if @listener_ranking_token %><%= form.hidden_field :listener_ranking_token, value: @listener_ranking_token, id: nil %><% end %>
      <%= form.label :comment, "Exception comment (optional)", for: "exception-comment-#{mbid}" %>
      <%= form.text_field :comment, id: "exception-comment-#{mbid}", maxlength: 500 %>
      <%= form.button "Resolve observation #{target.id} only", name: "mode", value: "resolved" %>
    <% end %>
  </details>
  <% end %>
</details>
