<div id="archive_dashboard" data-controller="dashboard-sync" data-dashboard-sync-url-value="<%= dashboard_updates_path(q: @query.presence) %>" data-dashboard-sync-version-value="<%= @account&.updated_at&.iso8601(6) if @first_page %>">
<h1 class="visually-hidden">Listening archive</h1>
<%= render "home/recent", archive: true %>
<nav aria-label="Archive pages" class="archive-pages">
  <% unless @first_page %><%= entity_link "Latest plays", archive_path(q: @query.presence) %><% end %>
  <% if @next_page %><%= entity_link "Older plays", archive_path(before: @next_page, q: @query.presence) %><% end %>
  <%= link_to "Archive summary", archive_summary_path, class: "entity-link", data: { turbo_prefetch: false } %>
</nav>
<div class="columns archive-settings">
  <section class="card">
    <h2>Last.fm account</h2>
    <% if @account.present? %>
      <p class="source-name"><%= @account.username %></p>
      <% if @ownership %>
        <p class="muted">Ownership recorded by Muzeum administration.</p>
      <% else %>
        <p class="muted">Associated public archive · ownership unverified</p>
      <% end %>
    <% else %>
      <p class="muted">Associate a public username to begin. No Last.fm password is needed.</p>
      <%= form_with url: lastfm_account_path, method: :patch do |form| %>
        <%= form.label :lastfm_username, "Last.fm username" %>
        <div class="field-row"><%= form.text_field :lastfm_username, required: true, maxlength: 64, autocomplete: "off" %><%= form.button "Associate" %></div>
      <% end %>
    <% end %>
  </section>
  <% if @can_manage_account || @account.nil? %>
  <section class="card">
    <h2>Import status</h2>
    <% if @run %>
      <p><%= @run.status.capitalize %> · <%= number_with_delimiter(@run.scrobbles_processed.to_i) %> new observations</p>
      <p class="muted">Main pages saved: <%= @run.next_page - 1 %><%= " / #{@run.total_pages}" if @run.total_pages %></p>
      <% if @run.total_pages.to_i.positive? %><progress aria-label="Import pages saved" value="<%= @run.next_page - 1 %>" max="<%= @run.total_pages %>"></progress><% end %>
      <p class="muted">Last successful update: <%= @run.last_success_at&.utc&.strftime("%Y-%m-%d %H:%M UTC") || "Not yet" %></p>
      <p class="muted">Delivered: <%= number_with_delimiter(@run.received_count) %> · repeated: <%= number_with_delimiter(@run.repeated_count) %> · excluded from listening events: <%= number_with_delimiter(@run.excluded_count) %></p>
      <% if @run.last_error %><p class="error" role="alert"><%= lastfm_import_error(@run) %></p><% end %>
    <% else %><p class="muted">No import started. Progress will be saved after each page.</p><% end %>
    <% if @account&.state == "active" && (!@run || @run.paused? || @run.failed?) %>
      <%= button_to "Retry synchronization", imports_path %>
      <% if @run&.failed? %><%= button_to "Restart recorded interval", imports_path(restart: "1") %><% end %>
    <% elsif @account && @account.state != "active" %>
      <p class="muted">Synchronization needs operator review. Existing observations remain available.</p>
    <% end %>
    <% if @account %>
      <p class="muted">Automatic synchronization: <%= @account.sync_enabled? ? @account.state : "disabled" %></p>
      <% if @run&.paused? && @account.state == "active" && @account.sync_enabled? &&
          ENV["LASTFM_SYNC_ENABLED"] == "1" && @account.next_poll_at.future? %>
        <p class="muted">Next automatic retry: <%= browser_time(@account.next_poll_at, clock: true) %></p>
      <% end %>
      <p class="muted">Last successful poll: <%= @account.last_successful_poll_at&.utc&.strftime("%Y-%m-%d %H:%M:%S UTC") || "Not yet" %></p>
      <p class="muted">Coverage lag: <%= @account.synced_through ? "#{[Time.current.to_i - @account.synced_through, 0].max} seconds" : "Historical coverage pending" %> · failures: <%= @account.failure_count %></p>
      <% if @account.last_error.present? && @account.last_error != @run&.last_error %><p class="error" role="alert"><%= @account.last_error %></p><% end %>
    <% end %>
    <% if @first_page %><p class="muted">Committed updates appear automatically while this page is open.</p><% end %>
  </section>
  <% end %>
</div>
</div>
