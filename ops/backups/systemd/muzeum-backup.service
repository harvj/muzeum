[Unit]
Description=Muzeum off-host production backup (gated configuration)
Wants=network-online.target
After=network-online.target postgresql.service
OnFailure=muzeum-backup-alert@%n.service
[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/lib/harvj-backups/muzeum-backup backup
TimeoutStartSec=2h
CPUQuota=25%
MemoryHigh=768M
MemoryMax=1G
Nice=10
IOSchedulingClass=idle
IOReadBandwidthMax=/dev/sda3 20M
IOWriteBandwidthMax=/dev/sda3 10M
LimitFSIZE=2G
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/harvj-backups
