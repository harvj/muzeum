[Unit]
Description=Check Muzeum backup freshness
OnFailure=muzeum-backup-alert@%n.service
[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/lib/harvj-backups/muzeum-backup monitor
CPUQuota=10%
MemoryMax=128M
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/harvj-backups
