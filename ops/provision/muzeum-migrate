#!/usr/bin/env python3
"""Migrate only an exact Muzeum candidate as the isolated migration OS identity."""
import fcntl,json,os,re,signal,subprocess,sys
from pathlib import Path
def run_bounded(argv, *, cwd, env, timeout):
    process = subprocess.Popen(argv, cwd=cwd, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
    try:
        stdout, stderr = process.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        os.killpg(process.pid, signal.SIGTERM)
        try:
            stdout, stderr = process.communicate(timeout=15)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            stdout, stderr = process.communicate()
        return subprocess.CompletedProcess(argv, 124, stdout, stderr + b'\nBounded migration process group timed out; inspect schema before retry.\n')
    return subprocess.CompletedProcess(argv, process.returncode, stdout, stderr)


def main():
    if os.geteuid()!=0 or len(sys.argv)!=3:raise RuntimeError()
    release=Path(sys.argv[1]).resolve(strict=True);sha=sys.argv[2]
    if release.parent!=Path('/var/www/muzeum/releases') or not re.fullmatch('[a-f0-9]{40}',sha) or (release/'REVISION').read_text().strip()!=sha:raise RuntimeError()
    os.umask(0o077)
    with open('/etc/muzeum/migration.lock','a') as lock:
        fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
        env={'LANG':'C.UTF-8','HOME':'/home/muzeum-migrate','BUNDLE_WITHOUT':'development:test','BUNDLE_IGNORE_CONFIG':'1','BUNDLE_DEPLOYMENT':'true','BUNDLE_FROZEN':'true','BOOTSNAP_READONLY':'1','PGOPTIONS':'-c lock_timeout=5000 -c statement_timeout=120000'}
        for line in Path('/etc/muzeum/migrate.env').read_text().splitlines():
            name,value=line.split('=',1);env[name]=value
        env.update(BOOTSNAP_READONLY='1', PGOPTIONS='-c lock_timeout=5000 -c statement_timeout=120000')
        sys.path.insert(0, '/usr/local/lib/muzeum-runtime')
        from muzeum_runtime import BASELINE, FORWARD, release_runtime, runtime_environment
        if sha != BASELINE:
            receipt = json.loads(Path('/var/lib/muzeum-deploy/active.json').read_text())
            if sha != FORWARD or receipt.get('sha') != sha or receipt.get('release') != str(release) or not receipt.get('migrating'):
                raise RuntimeError('Active guarded migration required')
        directory, bundle_path = release_runtime(release, sha)
        env = runtime_environment(env, directory, bundle_path)
        env.update(BUNDLE_IGNORE_CONFIG='1', BUNDLE_DEPLOYMENT='true', BUNDLE_FROZEN='true', BUNDLE_WITHOUT='development:test')
        env['BUNDLE_GEMFILE']=str(release/'Gemfile')
        # Only empty auxiliary databases may receive an explicit first bootstrap.
        ruby="""require 'bundler/setup';require './config/environment';
%w[cache queue cable].each do |name|
 config=ActiveRecord::Base.configurations.configs_for(env_name:'production',name:name)
 ActiveRecord::Base.establish_connection(config)
 if ActiveRecord::Base.connection.tables.empty?
  load Rails.root.join('db',name+'_schema.rb')
 end
end
"""
        result=run_bounded(['/usr/sbin/runuser','-u','muzeum-migrate','--',str(directory / 'ruby'),'-e',ruby],cwd=release,env=env,timeout=120)
        if result.returncode:
            diagnostic=Path('/etc/muzeum/migration-last-error')
            fd=os.open(diagnostic,os.O_WRONLY|os.O_CREAT|os.O_TRUNC|os.O_NOFOLLOW,0o600)
            with os.fdopen(fd,'wb') as out:out.write(result.stderr)
            raise RuntimeError()
        result=run_bounded(['/usr/sbin/runuser','-u','muzeum-migrate','--',str(directory / 'bundle'),'exec','rails','db:migrate'],cwd=release,env=env,timeout=180)
        if result.returncode:
            diagnostic=Path('/etc/muzeum/migration-last-error')
            fd=os.open(diagnostic,os.O_WRONLY|os.O_CREAT|os.O_TRUNC|os.O_NOFOLLOW,0o600)
            with os.fdopen(fd,'wb') as out:out.write(result.stderr)
            raise RuntimeError()
    print('Exact Muzeum candidate migration completed with isolated migrator credentials.')

if __name__ == '__main__':
    try:
        main()
    except Exception:
        print('Muzeum migration stopped; details suppressed; inspect protected diagnostics before retry.',file=sys.stderr)
        raise SystemExit(1)
