#!/usr/bin/env python3
"""Sign one reviewed Muzeum release payload on the operator's machine."""
import argparse
import base64
import json
import os
from pathlib import Path
import subprocess
import tempfile

from release_authorization import load_signed


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('review', type=Path)
    parser.add_argument('output', type=Path)
    parser.add_argument('--key', required=True, type=Path)
    args = parser.parse_args()
    with args.review.open('rb') as source:
        payload = source.read(8193)
    if len(payload) > 8192:
        parser.error('Review payload exceeds 8 KiB')

    with tempfile.TemporaryDirectory(prefix='muzeum-review-') as tmp:
        review, public = (Path(tmp) / name for name in ('review', 'public'))
        review.write_bytes(payload)
        signature = subprocess.check_output(['openssl', 'pkeyutl', '-sign', '-inkey', str(args.key),
                                             '-rawin', '-in', str(review)])
        subprocess.run(['openssl', 'pkey', '-in', str(args.key), '-pubout', '-out', str(public)], check=True)
        envelope = json.dumps({'payload': base64.b64encode(payload).decode(),
                               'signature': base64.b64encode(signature).decode()}).encode()
        if len(envelope) >= 24576:
            parser.error('Approval envelope exceeds 24 KiB')
        # The deployed helper fixes its OpenSSL executable. Select the local operator's OpenSSL here.
        import release_authorization
        release_authorization.OPENSSL = 'openssl'
        approval, digest = load_signed(base64.b64encode(envelope), key=public)
    os.umask(0o077)
    with args.output.open('xb') as output:
        output.write(envelope + b'\n')
    print(f"Authorized Muzeum {approval['version']} at {approval['sha']}; receipt digest {digest}")


if __name__ == '__main__':
    main()
