{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Application Shell release identity records, schema version 1",
    "description": "Shape only. Verify provenance, candidate matching and chronology before retaining a published receipt.",
    "oneOf": [
      {
        "$ref": "#/$defs/development"
      },
      {
        "$ref": "#/$defs/candidate"
      },
      {
        "$ref": "#/$defs/publication"
      }
    ],
    "$defs": {
      "development": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "application",
          "target_version",
          "source_sha",
          "artifact_sha256",
          "kind"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "application": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "target_version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "source_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "const": "development"
          }
        }
      },
      "candidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "application",
          "target_version",
          "source_sha",
          "artifact_sha256",
          "kind",
          "candidate_number"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "application": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "target_version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "source_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "const": "candidate"
          },
          "candidate_number": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "publication": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "kind",
          "candidate",
          "final_version",
          "acceptance_ref",
          "publication_ref",
          "accepted_at",
          "published_at",
          "verified_at"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "kind": {
            "const": "publication"
          },
          "candidate": {
            "$ref": "#/$defs/candidate"
          },
          "final_version": {
            "type": "string",
            "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "acceptance_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "\\S"
          },
          "publication_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "\\S"
          },
          "accepted_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "published_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "verified_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          }
        }
      }
    }
  },
